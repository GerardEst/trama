{
  "name": "@trama/engine",
  "version": "0.1.0",
  "description": "Play Trama stories anywhere: resolves nodes, events and requirements without any UI.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "trama",
    "interactive-fiction",
    "text-adventure",
    "branching-narrative"
  ],
  "homepage": "https://trama.app",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --target es2020",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "5.5",
    "vitest": "^2.1.9"
  }
}
