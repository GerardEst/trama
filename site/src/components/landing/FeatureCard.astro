---
interface Props {
  label: string
  title: string
  description: string
  link: { href: string; label: string }
  /** Spans two columns of the grid. */
  wide?: boolean
}

const { label, title, description, link, wide = false } = Astro.props
---

<article class="feature-card" data-wide={wide || undefined}>
  <div class="feature-card__visual" aria-hidden="true">
    <div class="feature-card__stage"><slot /></div>
  </div>
  <div class="feature-card__copy">
    <p class="feature-card__label">{label}</p>
    <h3>{title}</h3>
    <p class="feature-card__description">{description}</p>
  </div>
  <a class="feature-card__link" href={link.href}>{link.label} <span aria-hidden="true">→</span></a>
</article>

<style>
  .feature-card {
    position: relative;
    height: 100%;
    min-width: 0;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    overflow: hidden;
    border-radius: var(--polo-radius-card);
    background: var(--polo-color-surface);
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--polo-color-shadow) 6%, transparent),
      0 2px 4px color-mix(in srgb, var(--polo-color-shadow) 5%, transparent),
      0 12px 24px color-mix(in srgb, var(--polo-color-shadow) 5%, transparent);
    transition: box-shadow 0.3s;
  }
  .feature-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: radial-gradient(
      circle,
      color-mix(in srgb, var(--polo-color-text-strong) 15%, transparent) 1px,
      transparent 1.2px
    );
    background-size: 16px 16px;
    mask-image: radial-gradient(120% 80% at 80% 0%, black, transparent);
  }
  .feature-card::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: transparent;
    transition: background 0.3s;
  }
  .feature-card:hover,
  .feature-card:focus-within {
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--polo-color-shadow) 12%, transparent),
      0 4px 8px color-mix(in srgb, var(--polo-color-shadow) 5%, transparent),
      0 18px 36px color-mix(in srgb, var(--polo-color-shadow) 7%, transparent);
  }
  .feature-card:hover::after,
  .feature-card:focus-within::after {
    background: color-mix(in srgb, var(--polo-color-action) 2%, transparent);
  }

  .feature-card__visual {
    position: relative;
    flex: 1;
    min-height: 0;
    overflow: hidden;
    pointer-events: none;
    mask-image: linear-gradient(to bottom, black 70%, transparent);
  }
  .feature-card__stage {
    position: absolute;
    inset: 0;
  }

  .feature-card__copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 0 24px 24px;
    transition: transform 0.3s;
  }

  .feature-card__label {
    color: var(--polo-color-action);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.13em;
    transform-origin: left;
    transition: transform 0.3s;
  }

  h3 {
    font: 800 22px / 1.2 var(--polo-font-ui);
    letter-spacing: -0.035em;
  }

  .feature-card__description {
    max-width: 520px;
    color: var(--polo-color-text-secondary);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.6;
  }

  .feature-card__link {
    position: absolute;
    z-index: 1;
    bottom: 22px;
    left: 24px;
    font-size: 13px;
    font-weight: 800;
    border-bottom: 1px solid currentColor;
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.3s, transform 0.3s;
  }
  .feature-card__link span {
    margin-left: 6px;
  }
  .feature-card__link:hover {
    color: var(--polo-color-action);
  }

  .feature-card:hover .feature-card__copy,
  .feature-card:focus-within .feature-card__copy {
    transform: translateY(-36px);
  }
  .feature-card:hover .feature-card__label,
  .feature-card:focus-within .feature-card__label {
    transform: scale(0.9);
  }
  .feature-card:hover .feature-card__link,
  .feature-card:focus-within .feature-card__link {
    opacity: 1;
    transform: translateY(0);
  }

  @media (hover: none), (max-width: 760px) {
    .feature-card__copy {
      padding-bottom: 12px;
    }
    .feature-card__link {
      position: static;
      align-self: flex-start;
      margin: 0 24px 22px;
      opacity: 1;
      transform: none;
    }
    .feature-card:hover .feature-card__copy,
    .feature-card:focus-within .feature-card__copy {
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .feature-card__copy,
    .feature-card__label,
    .feature-card__link {
      transition: none;
    }
  }
</style>
