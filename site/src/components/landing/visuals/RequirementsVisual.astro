---
import Chip from './Chip.astro'
import { copyFor, type Lang } from '../../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).visuals
const choices = [
  { label: t.openArchive, requirement: t.requiresKey, available: true },
  { label: t.buyMap, requirement: t.requiresCoins, available: false },
  { label: t.walkAway, available: true },
]
---

<div class="requirements">
  <p class="requirements__stats"><Chip>{t.coins}</Chip><Chip>{t.hasKey}</Chip></p>
  <div class="requirements__choices">
    {choices.map(choice => (
      <p class:list={['choice', choice.available ? 'choice--available' : 'choice--locked']}>
        {choice.label} {choice.requirement && <small>{choice.requirement}</small>}
      </p>
    ))}
  </div>
</div>

<style>
  .requirements {
    position: absolute;
    top: 26px;
    left: 50%;
    width: min(100% - 40px, 420px);
    transform: translateX(-50%);
  }

  .requirements__stats {
    display: flex;
    justify-content: center;
    gap: var(--polo-space-2);
    margin-bottom: 14px;
  }

  .requirements__choices {
    display: flex;
    flex-direction: column;
    gap: var(--polo-space-2);
  }

  .choice {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--polo-space-3);
    padding: 11px 14px;
    border: 1px solid color-mix(in srgb, var(--polo-color-text-strong) 15%, transparent);
    border-radius: var(--polo-radius-control);
    background: var(--polo-color-surface);
    color: var(--polo-color-text-strong);
    font-size: 13px;
    font-weight: 800;
    transition: transform 0.3s;
  }
  .choice small {
    color: var(--polo-color-action);
    font-size: 11px;
    font-weight: 700;
  }

  .choice--available {
    box-shadow: 0 3px 0 color-mix(in srgb, var(--polo-color-shadow) 7%, transparent);
  }
  :global(.feature-card:hover) .choice--available {
    transform: translateX(4px);
  }

  .choice--locked {
    border-style: dashed;
    background: transparent;
    color: color-mix(in srgb, var(--polo-color-text-strong) 40%, transparent);
  }
  .choice--locked small {
    color: var(--polo-color-warning);
  }
  .choice--locked small::before {
    content: '🔒 ';
  }

  @media (prefers-reduced-motion: reduce) {
    .choice {
      transition: none;
    }
  }
</style>
