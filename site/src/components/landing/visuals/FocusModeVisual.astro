---
import Token from './Token.astro'
import { copyFor, type Lang } from '../../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).visuals
---

<div class="editor">
  <p class="editor__toolbar">
    <b>B</b><i>I</i><span>H</span><span>•</span><Token>#</Token>
    <span class="editor__close">{t.close}</span>
  </p>
  <div class="editor__page">
    <p class="editor__heading">{t.chapterHeading}</p>
    <p>{t.passageStart} <Token>{t.nameToken}</Token> {t.passageEnd}</p>
    <span class="editor__line"></span>
    <span class="editor__line editor__line--short"></span>
  </div>
</div>

<style>
  .editor {
    position: absolute;
    top: 24px;
    left: 50%;
    width: min(100% - 40px, 520px);
    border: 1px solid color-mix(in srgb, var(--polo-color-text-strong) 15%, transparent);
    border-radius: var(--polo-radius-panel);
    background: var(--polo-color-surface);
    box-shadow: 0 12px 30px color-mix(in srgb, var(--polo-color-shadow) 6%, transparent);
    transform: translateX(-50%);
  }

  .editor p {
    color: var(--polo-color-text-strong);
    font-size: inherit;
  }

  .editor__toolbar {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 9px 14px;
    border-bottom: 1px solid color-mix(in srgb, var(--polo-color-text-strong) 10%, transparent);
    font-size: 13px;
  }
  .editor .editor__toolbar {
    color: var(--polo-color-text-secondary);
  }

  .editor__close {
    margin-left: auto;
    color: var(--polo-color-action);
    font-size: 12px;
    font-weight: 800;
  }

  .editor__page {
    padding: 16px 22px;
    color: var(--polo-color-text-strong);
    font: 400 14px / 1.7 var(--polo-font-story);
  }

  .editor .editor__heading {
    margin-bottom: 6px;
    font: 800 15px var(--polo-font-ui);
    letter-spacing: -0.02em;
  }

  .editor__line {
    display: block;
    height: 8px;
    margin-top: var(--polo-space-3);
    border-radius: 4px;
    background: color-mix(in srgb, var(--polo-color-text-strong) 6%, transparent);
  }
  .editor__line--short {
    width: 60%;
  }
</style>
