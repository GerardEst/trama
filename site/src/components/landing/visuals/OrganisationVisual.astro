---
import { copyFor, type Lang } from '../../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).visuals
---

<div class="organisation">
  <div class="frame">
    <p class="frame__name">{t.chapter2}</p>
    <span class="mini-node mini-node--a"></span>
    <span class="mini-node mini-node--b"></span>
    <span class="mini-node mini-node--c"></span>
    <svg class="frame__links" viewBox="0 0 200 110" preserveAspectRatio="none">
      <path d="M58 32 C 90 32, 110 26, 138 24"></path>
      <path d="M37 42 C 37 80, 50 80, 68 80"></path>
    </svg>
  </div>
  <div class="group-node">
    <p>{t.chapter3}</p>
    <small>{t.scenes}</small>
  </div>
</div>

<style>
  .organisation {
    position: absolute;
    top: 26px;
    left: 50%;
    width: min(100% - 72px, 280px);
    transform: translateX(-50%);
  }

  .frame {
    position: relative;
    aspect-ratio: 200 / 110;
    border: 1.5px dashed color-mix(in srgb, var(--polo-color-action) 40%, transparent);
    border-radius: var(--polo-radius-panel);
    background: color-mix(in srgb, var(--polo-color-action) 3%, transparent);
    transition: transform 0.3s;
  }
  :global(.feature-card:hover) .frame {
    transform: translate(-6px, -4px);
  }

  .frame__name {
    position: absolute;
    top: -11px;
    left: 12px;
    padding: 2px 8px;
    border-radius: 6px;
    background: var(--polo-color-action);
    color: var(--polo-color-text-on-action);
    font-size: 11px;
    font-weight: 800;
  }

  .frame__links {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .frame__links path {
    fill: none;
    stroke: color-mix(in srgb, var(--polo-color-action) 50%, transparent);
    stroke-width: 1.5;
    vector-effect: non-scaling-stroke;
  }

  .mini-node {
    position: absolute;
    z-index: 1;
    height: 18%;
    border: 1px solid color-mix(in srgb, var(--polo-color-text-strong) 20%, transparent);
    border-radius: 6px;
    background: var(--polo-color-surface);
    box-shadow: 0 2px 0 color-mix(in srgb, var(--polo-color-shadow) 7%, transparent);
  }
  .mini-node--a {
    top: 20%;
    left: 8%;
    width: 21%;
  }
  .mini-node--b {
    top: 64%;
    left: 34%;
    width: 26%;
  }
  .mini-node--c {
    top: 13%;
    left: 69%;
    width: 22%;
  }

  .group-node {
    position: absolute;
    right: -16px;
    bottom: -26px;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    width: 52%;
    padding: 10px 12px;
    border: 1px solid color-mix(in srgb, var(--polo-color-text-strong) 20%, transparent);
    border-radius: var(--polo-radius-control);
    background: var(--polo-color-surface);
    box-shadow:
      4px 4px 0 -1px var(--polo-color-surface),
      4px 4px 0 0 color-mix(in srgb, var(--polo-color-shadow) 20%, transparent);
  }
  .group-node p {
    color: var(--polo-color-text-strong);
    font-size: 12px;
    font-weight: 800;
  }
  .group-node small {
    color: var(--polo-color-text-secondary);
    font-size: 11px;
    font-weight: 700;
  }

  @media (prefers-reduced-motion: reduce) {
    .frame {
      transition: none;
    }
  }
</style>
