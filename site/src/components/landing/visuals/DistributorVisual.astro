---
import FloatingNode from './FloatingNode.astro'
import { copyFor, type Lang } from '../../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).visuals
const routes = [
  { rule: t.secretRule, target: t.secretEntrance, kind: 'match' },
  { rule: t.frontRule, target: t.frontEntrance, kind: 'route' },
  { rule: t.otherwise, target: t.gatekeeper, kind: 'fallback' },
]
---

<FloatingNode title={t.distributor}>
  {routes.map(route => (
    <p class:list={['route', `route--${route.kind}`]}><span>{route.rule}</span><span>{route.target}</span></p>
  ))}
</FloatingNode>

<style>
  .route {
    display: flex;
    justify-content: space-between;
    gap: var(--polo-space-3);
    padding: 8px 10px;
    border-radius: 8px;
    color: var(--polo-color-text-secondary);
    font-size: 12px;
    font-weight: 700;
  }
  .route span:last-child {
    color: var(--polo-color-text-strong);
    white-space: nowrap;
  }
  .route span:last-child::before {
    content: '→ ';
    color: var(--polo-color-text-secondary);
  }
  .route + .route {
    margin-top: var(--polo-space-1);
  }

  .route--match {
    background: color-mix(in srgb, var(--polo-color-action) 7%, transparent);
    box-shadow: inset 3px 0 0 var(--polo-color-action);
    color: var(--polo-color-action);
  }

  .route--fallback {
    border-top: 1px dashed color-mix(in srgb, var(--polo-color-text-strong) 15%, transparent);
    border-radius: 0 0 8px 8px;
  }
</style>
