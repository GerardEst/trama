---
import Chip from './Chip.astro'
import { EVENT_ROWS } from './event-rows'
import type { Lang } from '../../../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
---

<div class="events">
  {EVENT_ROWS[lang].map((row, index) => (
    <div class:list={['events__row', { 'events__row--reverse': index % 2 === 1 }]}>
      {/* Each row is drawn twice so the loop has no visible seam. */}
      {[0, 1].map(() => (
        <div class="events__track">
          {row.map(event => <Chip>{event}</Chip>)}
        </div>
      ))}
    </div>
  ))}
</div>

<style>
  .events {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 28px;
    overflow: hidden;
  }

  .events__row {
    display: flex;
    gap: 10px;
    overflow: hidden;
  }
  :global(.feature-card:hover) .events__track {
    animation-play-state: paused;
  }

  .events__track {
    display: flex;
    flex-shrink: 0;
    gap: 10px;
    animation: marquee 32s linear infinite;
  }
  .events__row--reverse .events__track {
    animation-direction: reverse;
  }

  @keyframes marquee {
    to {
      transform: translateX(calc(-100% - 10px));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .events__track {
      animation: none;
    }
  }
</style>
