---
import FloatingNode from './FloatingNode.astro'
import Token from './Token.astro'
import { copyFor, type Lang } from '../../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).visuals
---

<FloatingNode title={t.askName}>
  <p class="field"><span class="field__typed">Morgan</span></p>
  <p class="result">
    {t.welcomeBack} <Token>{t.nameToken}</Token> <span class="result__arrow">→</span> <strong>Morgan</strong>.
  </p>
</FloatingNode>

<style>
  .field {
    position: relative;
    padding: 9px 12px;
    border: 1px solid color-mix(in srgb, var(--polo-color-text-strong) 20%, transparent);
    border-radius: 8px;
    background: var(--polo-color-surface);
    color: var(--polo-color-text-strong);
    font-size: 13px;
    font-weight: 700;
  }

  .field__typed {
    display: inline-block;
    overflow: hidden;
    vertical-align: bottom;
    white-space: nowrap;
    border-right: 2px solid var(--polo-color-action);
    animation: typing 4s steps(6) infinite, caret 0.8s step-end infinite;
  }

  .result {
    margin-top: 14px;
    color: var(--polo-color-text-secondary);
    font-size: 13px;
    font-weight: 600;
    line-height: 1.8;
  }
  .result strong {
    color: var(--polo-color-text-strong);
  }

  .result__arrow {
    color: var(--polo-color-action);
  }

  @keyframes typing {
    0% {
      width: 0;
    }
    40%,
    90% {
      width: 6.2ch;
    }
    100% {
      width: 0;
    }
  }
  @keyframes caret {
    50% {
      border-color: transparent;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .field__typed {
      animation: none;
    }
  }
</style>
