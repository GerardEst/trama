---
import type { ImageMetadata } from 'astro'
import { getImage, Image } from 'astro:assets'
import Eyebrow from '../ui/Eyebrow.astro'
import { copyFor, type Lang } from '../../i18n'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)
const VIEWS = ['write', 'map', 'preview', 'share'] as const

const captures = import.meta.glob<{ default: ImageMetadata }>('../../assets/landing/authoring/*.webp', { eager: true })
const views = await Promise.all(VIEWS.map(async (view, index) => {
  const image = captures[`../../assets/landing/authoring/${lang}-${view}.webp`]?.default
  if (!image) throw new Error(`Missing authoring capture ${lang}-${view}.webp`)
  const fullSize = await getImage({ src: image, format: 'webp' })
  return { view, number: `0${index + 1}`, image, fullSize: fullSize.src, copy: t.authoring[view] }
}))
---

<section id="authoring" class="section-container authoring" aria-labelledby="authoring-title">
  <div class="authoring__heading">
    <Eyebrow>{t.authoring.eyebrow}</Eyebrow>
    <h2 id="authoring-title">{t.authoring.title}</h2>
    <p>{t.authoring.description}</p>
  </div>
  <authoring-tour>
    <ol class="authoring__steps">
      {views.map(({ view, number, copy }, index) => (
        <li>
          <button type="button" data-view={view} aria-pressed={index === 0 ? 'true' : 'false'} aria-controls="authoring-capture">
            <span class="authoring__number" aria-hidden="true">{number}</span>
            <span class="authoring__step-title">{copy.title}</span>
            <span class="authoring__step-description">{copy.description}</span>
          </button>
        </li>
      ))}
    </ol>
    <figure id="authoring-capture" class="authoring__capture">
      {views.map(({ view, image, fullSize, copy }, index) => (
        <a href={fullSize} target="_blank" rel="noopener" aria-label={t.authoring.enlarge} data-view={view} hidden={index > 0}>
          <Image
            src={image}
            alt={copy.alt}
            widths={[800, 1200, image.width]}
            sizes="(max-width: 1296px) calc(100vw - 48px), 1248px"
            loading="lazy"
          />
        </a>
      ))}
      <figcaption aria-live="polite">
        {views.map(({ view, copy }, index) => <span data-view={view} hidden={index > 0}>{copy.caption}</span>)}
        <span class="authoring__real">{t.authoring.realCapture}</span>
      </figcaption>
    </figure>
  </authoring-tour>
</section>

<script>
  // Switches the capture and its caption to the chosen step of the workflow.
  class AuthoringTour extends HTMLElement {
    connectedCallback() {
      this.addEventListener('click', this.select)
    }

    disconnectedCallback() {
      this.removeEventListener('click', this.select)
    }

    private select = (event: MouseEvent) => {
      const button = (event.target as Element).closest<HTMLButtonElement>('button[data-view]')
      if (!button) return
      const view = button.dataset['view']
      for (const step of this.querySelectorAll<HTMLButtonElement>('button[data-view]')) {
        step.setAttribute('aria-pressed', String(step === button))
      }
      for (const part of this.querySelectorAll<HTMLElement>('figure [data-view]')) {
        part.hidden = part.dataset['view'] !== view
      }
    }
  }

  customElements.define('authoring-tour', AuthoringTour)
</script>

<style>
  .authoring {
    padding: 72px 0 8px;
    scroll-margin-top: var(--site-header-offset);
  }

  .authoring__heading {
    max-width: 780px;
    margin-bottom: 36px;
  }

  h2 {
    margin-top: 16px;
    color: var(--polo-color-text);
    font: 800 clamp(32px, 4vw, 50px) / 1.15 var(--polo-font-ui);
    letter-spacing: -0.05em;
  }

  .authoring__heading > p:last-child {
    max-width: 640px;
    margin-top: 20px;
    color: var(--polo-color-text-secondary);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
  }

  authoring-tour {
    display: block;
  }

  .authoring__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
    margin: 0 0 24px;
  }

  .authoring__steps li {
    min-width: 0;
  }

  .authoring__steps button {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    height: 100%;
    padding: 20px;
    border: 1px solid var(--polo-color-border);
    border-radius: var(--polo-radius-panel);
    background: var(--polo-color-surface);
    color: var(--polo-color-text);
    text-align: left;
    cursor: pointer;
  }
  .authoring__steps button:hover {
    border-color: var(--polo-color-action);
  }
  .authoring__steps button[aria-pressed='true'] {
    border-color: var(--polo-color-action);
    background: var(--polo-color-action-soft);
    box-shadow: inset 0 3px 0 var(--polo-color-action);
  }

  .authoring__number {
    color: var(--polo-color-action);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }

  .authoring__step-title {
    font-size: 20px;
    font-weight: 800;
    line-height: 1.25;
    letter-spacing: -0.03em;
  }

  .authoring__step-description {
    color: var(--polo-color-text-secondary);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.65;
  }

  .authoring__capture {
    overflow: hidden;
    border: 1px solid var(--polo-color-border-strong);
    border-radius: var(--polo-radius-card);
    background: var(--polo-color-surface);
    box-shadow: var(--polo-shadow-floating);
  }
  .authoring__capture a {
    display: block;
  }
  .authoring__capture a[hidden],
  figcaption [hidden] {
    display: none;
  }
  .authoring__capture img {
    display: block;
    width: 100%;
    height: auto;
  }
  .authoring__capture a:focus-visible {
    outline-offset: -5px;
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 20px;
    padding: 16px 20px;
    border-top: 1px solid var(--polo-color-border);
    color: var(--polo-color-text-secondary);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.65;
  }

  .authoring__real {
    flex-shrink: 0;
    color: var(--polo-color-action);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 1000px) {
    .authoring__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .authoring {
      padding-top: 48px;
    }
    .authoring__steps button {
      padding: 16px;
    }
    .authoring__step-title {
      font-size: 18px;
    }
    figcaption {
      flex-direction: column;
      gap: 8px;
      padding: 16px;
    }
  }

  @media (max-width: 380px) {
    .authoring__steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
