---
import StoryDemo from './StoryDemo.astro'
import Eyebrow from '../ui/Eyebrow.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import AuthLabel from '../ui/AuthLabel.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS } from '../../lib/links'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)
---

<section class="hero" aria-labelledby="hero-title">
  <div class="section-container hero__inner">
    <div class="hero__copy">
      <Eyebrow live>{t.hero.eyebrow}</Eyebrow>
      <h1 id="hero-title">{t.hero.titleStart}<br /><em>{t.hero.titleEnd}</em></h1>
      <p class="hero__description">{t.hero.description}</p>
      <div class="hero__actions">
        <ButtonLink variant="primary" href={APP_LINKS.register} signedInHref={APP_LINKS.dashboard} arrow="→">
          <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
        </ButtonLink>
        <ButtonLink href="#try-it" arrow="↓">{t.hero.tryStory}</ButtonLink>
      </div>
      <p class="hero__reassurance">
        <span>{t.hero.free}</span><span>{t.hero.noAccount}</span>
      </p>
    </div>
    <StoryDemo lang={lang} />
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      ellipse 70% 50% at 50% 26%,
      color-mix(in srgb, var(--polo-color-canvas) 91%, transparent),
      transparent
    );
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 78px 0 56px;
    gap: 56px;
  }

  .hero__copy {
    max-width: 850px;
    text-align: center;
  }

  h1 {
    margin-top: 20px;
    font: 800 clamp(48px, 6.4vw, 88px) / 1.08 var(--polo-font-ui);
    letter-spacing: -0.065em;
  }
  h1 em {
    position: relative;
    font-style: normal;
    white-space: nowrap;
  }
  h1 em::after {
    content: '';
    position: absolute;
    height: 0.16em;
    bottom: 0.03em;
    left: 1%;
    width: 98%;
    z-index: -1;
    border-radius: 50%;
    background: var(--polo-color-accent);
    transform: rotate(-1deg);
  }

  .hero__description {
    max-width: 630px;
    margin: 26px auto 0;
    color: var(--polo-color-text-secondary);
    font-size: 17px;
    font-weight: 500;
    line-height: 1.7;
  }

  .hero__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 22px;
    margin-top: 28px;
  }

  .hero__reassurance {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 22px;
    margin-top: 20px;
    color: var(--polo-color-text-secondary);
    font-size: 12px;
    font-weight: 600;
  }
  .hero__reassurance span::first-letter {
    color: var(--polo-color-action);
  }

  @media (max-width: 1000px) {
    h1 {
      font-size: clamp(48px, 6.4vw, 72px);
    }
  }

  @media (max-width: 760px) {
    .hero__inner {
      padding: 54px 0 40px;
      gap: 40px;
    }
    h1 {
      font-size: clamp(44px, 8vw, 64px);
    }
    h1 em {
      white-space: normal;
    }
    .hero__description {
      max-width: 560px;
    }
  }

  @media (max-width: 480px) {
    .hero__inner {
      padding-top: 42px;
      gap: 32px;
    }
    h1 {
      font-size: clamp(36px, 10vw, 48px);
    }
    .hero__description {
      margin-top: 20px;
      font-size: 16px;
    }
    .hero__actions {
      gap: var(--polo-space-4);
      margin-top: var(--polo-space-6);
    }
    .hero__reassurance {
      margin-top: var(--polo-space-4);
      gap: 6px 14px;
      font-size: 11px;
    }
  }
</style>
