---
import EngineWays from './EngineWays.astro'
import Eyebrow from '../../ui/Eyebrow.astro'
import { copyFor, type Lang } from '../../../i18n'
import { ENGINE_LINKS } from '../../../lib/links'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang).engine
const points = [t.points.same, t.points.design, t.points.live]
---

<section id="engine" class="section-container engine" aria-labelledby="engine-title">
  <div class="engine__heading">
    <Eyebrow>{t.eyebrow}</Eyebrow>
    <h2 id="engine-title">{t.titleStart} <em>{t.titleEnd}</em></h2>
    <p>{t.description}</p>
  </div>

  <ul class="engine__points">
    {points.map(point => (
      <li>
        <h3>{point.title}</h3>
        <p>{point.description}</p>
      </li>
    ))}
  </ul>

  <EngineWays lang={lang} />

  <div class="engine__links">
    <a class="engine__link" href={ENGINE_LINKS.npm} target="_blank" rel="noopener">{t.links.npm} <span aria-hidden="true">↗</span></a>
    <a class="engine__link" href={ENGINE_LINKS.source} target="_blank" rel="noopener">{t.links.source} <span aria-hidden="true">↗</span></a>
    <span class="engine__license">{t.links.license}</span>
  </div>
</section>

<style>
  .engine {
    padding: 72px 0;
    scroll-margin-top: var(--site-header-offset);
  }

  .engine__heading {
    max-width: 800px;
  }

  h2 {
    margin-top: 16px;
    color: var(--polo-color-text);
    font: 800 clamp(32px, 4vw, 50px) / 1.15 var(--polo-font-ui);
    letter-spacing: -0.05em;
  }
  h2 em {
    color: var(--polo-color-action);
    font-family: var(--polo-font-story);
    font-weight: 400;
    letter-spacing: -0.02em;
  }

  .engine__heading > p:last-child {
    max-width: 660px;
    margin-top: 20px;
    color: var(--polo-color-text-secondary);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
  }

  .engine__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    margin-top: 36px;
  }
  .engine__points li {
    padding-top: 20px;
    border-top: 1px solid var(--polo-color-border-strong);
  }
  .engine__points h3 {
    margin-bottom: 10px;
    font-size: 17px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.02em;
  }
  .engine__points p {
    color: var(--polo-color-text-secondary);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.7;
  }

  .engine__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 28px;
    margin-top: 28px;
  }
  .engine__link {
    color: var(--polo-color-text);
    text-decoration: underline;
    font-size: 15px;
    font-weight: 800;
  }
  .engine__link span {
    color: var(--polo-color-action);
  }
  .engine__link:hover {
    color: var(--polo-color-action);
  }
  .engine__license {
    color: var(--polo-color-text-muted);
    font-size: 13px;
    font-weight: 600;
  }

  @media (max-width: 760px) {
    .engine {
      padding: 48px 0;
    }
    .engine__points {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
      margin-top: 28px;
    }
  }
</style>
