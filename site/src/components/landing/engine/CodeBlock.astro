---
interface Props {
  label: string
  /** Wraps long lines (prose) instead of scrolling (code). */
  wrap?: boolean
  [key: `data-${string}`]: string
}

const { label, wrap = false, ...attributes } = Astro.props
---

<pre class:list={['code-block', { 'code-block--wrap': wrap }]} aria-label={label} tabindex="0" {...attributes}><slot /></pre>

<style>
  .code-block {
    margin: 18px 0 0;
    padding: 16px 18px;
    overflow-x: auto;
    border: 1px solid var(--polo-color-border);
    border-radius: var(--polo-radius-control);
    background: var(--polo-color-surface-muted);
    color: var(--polo-color-text);
    font: 500 13px / 1.65 ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    white-space: pre;
  }
  .code-block--wrap {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .code-block:focus-visible {
    outline: 2px solid var(--polo-color-focus);
    outline-offset: 2px;
  }
</style>
