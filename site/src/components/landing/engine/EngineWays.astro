---
import EngineCard from './EngineCard.astro'
import CodeBlock from './CodeBlock.astro'
import { copyFor, format, type Lang } from '../../../i18n'
import { ENGINE_LINKS } from '../../../lib/links'
import { engineExample, referenceCode } from '../../../lib/story-reference'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang).engine
const placeholder = referenceCode(null, t.agent.placeholderId)
const prompt = (reference: string) => format(t.agent.prompt, { reference, npm: ENGINE_LINKS.npm })
const strings = {
  prompt: t.agent.prompt,
  npm: ENGINE_LINKS.npm,
  placeholderId: t.agent.placeholderId,
  hint: t.agent.storyHint,
  invalid: t.agent.storyInvalid,
  copy: t.agent.copy,
  copied: t.agent.copied,
  copyFailed: t.agent.copyFailed,
}
---

<engine-ways data-strings={JSON.stringify(strings)}>
  <EngineCard id="engine-agent-title" featured label={t.agent.label} title={t.agent.title} description={t.agent.description}>
    <label class="field-label" for="engine-story">{t.agent.storyLabel}</label>
    <input
      id="engine-story"
      type="text"
      inputmode="url"
      autocomplete="off"
      spellcheck="false"
      placeholder="https://trama.app/private/…"
      aria-describedby="engine-story-hint"
      aria-invalid="false"
    />
    <p id="engine-story-hint" class="hint">{t.agent.storyHint}</p>
    <CodeBlock label={t.agent.promptLabel} wrap data-prompt="">{prompt(placeholder)}</CodeBlock>
    <div class="copy">
      <button type="button" class="copy__button">{t.agent.copy}</button>
      <span class="copy__status" aria-live="polite"></span>
    </div>
  </EngineCard>
  <EngineCard id="engine-code-title" label={t.code.label} title={t.code.title} description={t.code.description}>
    <CodeBlock label={t.code.codeLabel} data-code=""><code>{engineExample(placeholder)}</code></CodeBlock>
  </EngineCard>
</engine-ways>

<script>
  import { format } from '../../../lib/format'
  import { engineExample, referenceCode, storyReference } from '../../../lib/story-reference'

  interface Strings {
    prompt: string
    npm: string
    placeholderId: string
    hint: string
    invalid: string
    copy: string
    copied: string
    copyFailed: string
  }

  // Writes the agent prompt and the example code for the story the author pastes.
  class EngineWays extends HTMLElement {
    private strings!: Strings

    connectedCallback() {
      this.strings = JSON.parse(this.dataset['strings'] ?? '{}')
      this.input.addEventListener('input', this.update)
      this.button.addEventListener('click', this.copy)
      this.update()
    }

    disconnectedCallback() {
      this.input.removeEventListener('input', this.update)
      this.button.removeEventListener('click', this.copy)
    }

    private get input() {
      return this.querySelector('input')!
    }

    private get button() {
      return this.querySelector<HTMLButtonElement>('.copy__button')!
    }

    private get prompt() {
      const reference = storyReference(this.input.value)
      return format(this.strings.prompt, {
        reference: referenceCode(reference, this.strings.placeholderId),
        npm: this.strings.npm,
      })
    }

    private update = () => {
      const reference = storyReference(this.input.value)
      const invalid = !!this.input.value.trim() && !reference
      const code = referenceCode(reference, this.strings.placeholderId)
      this.input.setAttribute('aria-invalid', String(invalid))
      const hint = this.querySelector<HTMLElement>('.hint')!
      hint.textContent = invalid ? this.strings.invalid : this.strings.hint
      hint.classList.toggle('hint--invalid', invalid)
      this.querySelector('[data-prompt]')!.textContent = this.prompt
      this.querySelector('[data-code] code')!.textContent = engineExample(code)
      this.setCopyState('idle')
    }

    private copy = async () => {
      try {
        await navigator.clipboard.writeText(this.prompt)
        this.setCopyState('copied')
      } catch {
        this.setCopyState('failed')
      }
    }

    private setCopyState(state: 'idle' | 'copied' | 'failed') {
      this.button.textContent = state === 'copied' ? this.strings.copied : this.strings.copy
      this.querySelector('.copy__status')!.textContent = state === 'failed' ? this.strings.copyFailed : ''
    }
  }

  customElements.define('engine-ways', EngineWays)
</script>

<style>
  engine-ways {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 20px;
    margin-top: 44px;
  }
  /* The code card stretches its example to the agent card's height. */
  engine-ways > :global(:last-child pre) {
    flex: 1;
  }

  .field-label {
    display: block;
    margin-top: 22px;
    color: var(--polo-color-text);
    font-size: 13px;
    font-weight: 800;
  }

  input {
    width: 100%;
    min-height: 44px;
    margin-top: 8px;
    padding: 0 14px;
    border: 1px solid var(--polo-color-border-strong);
    border-radius: var(--polo-radius-control);
    background: var(--polo-color-canvas);
    color: var(--polo-color-text);
    font: 500 14px var(--polo-font-ui);
  }
  input::placeholder {
    color: var(--polo-color-placeholder);
  }
  input:focus-visible {
    outline: 2px solid var(--polo-color-focus);
    outline-offset: 2px;
  }
  input[aria-invalid='true'] {
    border-color: var(--polo-color-danger-border);
  }

  .hint {
    margin-top: 8px;
    color: var(--polo-color-text-muted);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.5;
  }
  .hint--invalid {
    color: var(--polo-color-danger-text);
  }

  .copy {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .copy__button {
    min-height: 44px;
    padding: 0 20px;
    border: none;
    border-radius: var(--polo-radius-control);
    background: var(--polo-color-accent);
    color: var(--polo-color-text-on-accent);
    font: 800 14px var(--polo-font-ui);
    cursor: pointer;
    box-shadow: 0 3px 0 color-mix(in srgb, var(--polo-color-shadow) 13%, transparent);
    transition: background 0.2s, transform 0.2s;
  }
  .copy__button:hover {
    background: var(--polo-color-accent-hover);
    transform: translateY(-1px);
  }
  .copy__button:focus-visible {
    outline: 2px solid var(--polo-color-focus);
    outline-offset: 2px;
  }

  .copy__status {
    color: var(--polo-color-danger-text);
    font-size: 13px;
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .copy__button {
      transition: none;
    }
    .copy__button:hover {
      transform: none;
    }
  }

  @media (max-width: 1000px) {
    engine-ways {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
