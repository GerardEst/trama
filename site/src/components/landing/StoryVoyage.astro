---
import VoyageBoat from './VoyageBoat.astro'
---

<story-voyage>
  <slot />
  <div class="voyage" aria-hidden="true">
    <svg class="voyage__chart" fill="none" focusable="false">
      <path class="voyage__route" />
      <g class="voyage__trail"></g>
    </svg>
    <div class="voyage__boat"><VoyageBoat /></div>
  </div>
</story-voyage>

<script>
  // The chart belongs to the FAQ and map together, so opening an answer or
  // changing the viewport recalculates the whole voyage in the same coordinates.
  class StoryVoyage extends HTMLElement {
    private observer?: IntersectionObserver
    private resizer?: ResizeObserver
    private motion?: MediaQueryList
    private frame = 0
    private visible = false
    private listening = false
    private startScroll = 0
    private endScroll = 1
    private length = 0
    private mapTop = 0
    private mapRevealDistance = 1
    private marks: {
      ink: SVGPathElement
      ripples: SVGPathElement[]
      distance: number
      opacity: number
      normalX: number
      normalY: number
      fade?: number
    }[] = []

    private get route() { return this.querySelector<SVGPathElement>('.voyage__route')! }
    private get boat() { return this.querySelector<HTMLElement>('.voyage__boat')! }

    connectedCallback() {
      this.motion = matchMedia('(prefers-reduced-motion: reduce)')
      this.motion.addEventListener('change', this.onMotion)
      this.resizer = new ResizeObserver(this.layout)
      this.resizer.observe(this)
      this.observer = new IntersectionObserver(entries => {
        this.visible = entries.some(entry => entry.isIntersecting)
        this.syncListening()
        if (this.visible) this.layout()
      }, { rootMargin: '200px 0px' })
      this.observer.observe(this)
      this.layout()
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.resizer?.disconnect()
      this.motion?.removeEventListener('change', this.onMotion)
      this.unlisten()
    }

    private onMotion = () => {
      this.syncListening()
      this.schedule()
    }

    private syncListening() {
      if (this.visible && !this.motion?.matches) {
        if (this.listening) return
        addEventListener('scroll', this.schedule, { passive: true })
        addEventListener('resize', this.layout, { passive: true })
        this.listening = true
      } else {
        this.unlisten()
      }
    }

    private unlisten() {
      removeEventListener('scroll', this.schedule)
      removeEventListener('resize', this.layout)
      this.listening = false
      cancelAnimationFrame(this.frame)
      this.frame = 0
    }

    private schedule = () => {
      if (this.frame) return
      this.frame = requestAnimationFrame(() => {
        this.frame = 0
        this.render()
      })
    }

    private layout = () => {
      const root = this.getBoundingClientRect()
      const heading = this.querySelector('#e-faq-title')!.getBoundingClientRect()
      const questions = this.querySelector('.lq')!.getBoundingClientRect()
      const map = this.querySelector('map-closing')!.getBoundingClientRect()
      const chart = this.querySelector<SVGSVGElement>('.voyage__chart')!
      const mapTop = map.top - root.top
      const compact = root.width <= 1040
      const portrait = root.width <= 600
      const startX = compact ? root.width * 0.22 : heading.left - root.left + heading.width * 0.52
      const startY = compact ? questions.bottom - root.top + 100 : heading.bottom - root.top + 92
      const image = this.querySelector<HTMLImageElement>('.story-map__image')!
      const imageBounds = image.getBoundingClientRect()
      const [alignX, alignY] = getComputedStyle(image).objectPosition.split(' ').map(value => parseFloat(value) / 100)
      const sourceWidth = portrait ? 1024 : 1984
      const sourceHeight = portrait ? 1536 : 1024
      const scale = Math.max(imageBounds.width / sourceWidth, imageBounds.height / sourceHeight)
      const offsetX = (imageBounds.width - sourceWidth * scale) * alignX
      const offsetY = (imageBounds.height - sourceHeight * scale) * alignY
      const water = (x: number, y: number) => `${offsetX + x * scale} ${mapTop + offsetY + y * scale}`
      // Coordinates traced in the actual artwork: the narrow northern channel
      // of the wide map, and the small northern bay of the portrait map.
      const entryX = offsetX + (portrait ? 640 : 410) * scale
      const entryY = mapTop + offsetY
      const endY = mapTop + offsetY + (portrait ? 55 : 210) * scale
      const gap = entryY - startY
      const approach = compact
        ? `C ${Math.max(48, startX - 40)} ${startY + gap * 0.4}, ${Math.max(48, entryX - 30)} ${entryY - gap * 0.3}, ${entryX} ${entryY}`
        : `C ${startX + 85} ${startY + gap * 0.18}, ${startX - 100} ${startY + gap * 0.24}, ${startX - 90} ${startY + gap * 0.43}
           C ${startX - 80} ${startY + gap * 0.65}, ${entryX - 85} ${entryY - gap * 0.18}, ${entryX - 25} ${entryY - gap * 0.08}
           C ${entryX - 9} ${entryY - gap * 0.045}, ${entryX - 10 * scale} ${entryY - 12 * scale}, ${entryX} ${entryY}`
      const sea = portrait
        ? `C ${water(641, 18)}, ${water(645, 40)}, ${water(650, 55)}`
        : `C ${water(425, 18)}, ${water(470, 48)}, ${water(480, 75)}
           C ${water(500, 115)}, ${water(555, 135)}, ${water(580, 160)}
           C ${water(605, 183)}, ${water(625, 198)}, ${water(650, 210)}`
      chart.setAttribute('viewBox', `0 0 ${root.width} ${root.height}`)
      this.route.setAttribute('d', `M ${startX} ${startY} ${approach} ${sea}`)
      this.length = this.route.getTotalLength()
      this.drawTrail()
      const documentTop = root.top + scrollY
      this.mapTop = documentTop + mapTop
      this.mapRevealDistance = Math.min(map.height, innerHeight * 0.85)
      // Scroll positions are rounded to pixels: both endpoints must be reachable.
      this.startScroll = Math.floor(documentTop + startY - innerHeight * 0.72)
      this.endScroll = Math.max(this.startScroll + 1, Math.floor(documentTop + endY - innerHeight * 0.48))
      this.classList.add('voyage--ready')
      this.render()
    }

    // Unequal lengths, gently bowed strokes and slightly varied pressure keep
    // the trail looking like pen marks. It is redrawn only when layout changes.
    private drawTrail() {
      const trail = this.querySelector<SVGGElement>('.voyage__trail')!
      const fragment = document.createDocumentFragment()
      const lengths = [5, 7, 4, 6, 5.5, 8]
      const gaps = [10, 9, 11, 8, 10, 9]
      this.marks = []
      let distance = 0
      let index = 0
      while (distance < this.length) {
        const size = lengths[index % lengths.length]
        const start = this.route.getPointAtLength(distance)
        const end = this.route.getPointAtLength(Math.min(this.length, distance + size))
        const dx = end.x - start.x
        const dy = end.y - start.y
        const magnitude = Math.hypot(dx, dy) || 1
        const bend = index % 2 ? 0.65 : -0.45
        const x = (start.x + end.x) / 2 - dy / magnitude * bend
        const y = (start.y + end.y) / 2 + dx / magnitude * bend
        const dash = document.createElementNS('http://www.w3.org/2000/svg', 'path')
        dash.classList.add('voyage__ink')
        dash.setAttribute('d', `M ${start.x} ${start.y} Q ${x} ${y} ${end.x} ${end.y}`)
        dash.setAttribute('stroke-width', String([1.3, 1.55, 1.15][index % 3]))
        const opacity = [0.6, 0.48, 0.7, 0.55][index % 4]
        dash.setAttribute('opacity', String(opacity))
        fragment.append(dash)
        const ripples = [-1, 1].map(() => {
          const ripple = dash.cloneNode() as SVGPathElement
          ripple.setAttribute('class', 'voyage__ripple')
          ripple.setAttribute('stroke-width', '0.8')
          ripple.setAttribute('opacity', '0')
          fragment.append(ripple)
          return ripple
        })
        this.marks.push({ ink: dash, ripples, distance, opacity, normalX: -dy / magnitude, normalY: dx / magnitude })
        distance += size + gaps[index % gaps.length]
        index++
      }
      trail.replaceChildren(fragment)
    }

    private disperseTrail(distance: number) {
      for (const mark of this.marks) {
        // The stern loosens the ink into two widening ripples, which disappear
        // over the next 110px. All geometry is cached when the chart is laid out.
        const fade = Math.min(1, Math.max(0, (distance - mark.distance) / 110))
        if (fade === mark.fade) continue
        mark.fade = fade
        const remaining = 1 - fade * fade * (3 - 2 * fade)
        mark.ink.setAttribute('opacity', String(mark.opacity * remaining))
        mark.ink.style.filter = fade > 0 && fade < 1 ? `blur(${fade * 2}px)` : ''
        const rippleOpacity = Math.sin(fade * Math.PI) * mark.opacity * 0.65
        mark.ripples.forEach((ripple, index) => {
          const spread = (3 + fade * 12) * (index === 0 ? -1 : 1)
          ripple.setAttribute('transform', `translate(${mark.normalX * spread} ${mark.normalY * spread})`)
          ripple.setAttribute('opacity', fade > 0 && fade < 1 ? String(rippleOpacity) : '0')
        })
      }
    }

    private render() {
      if (!this.length) return
      const scrollProgress = this.motion?.matches ? 1 : Math.min(1, Math.max(0,
        (scrollY - this.startScroll) / (this.endScroll - this.startScroll),
      ))
      const progress = scrollProgress * scrollProgress * (3 - 2 * scrollProgress)
      const distance = this.length * progress
      const point = this.route.getPointAtLength(distance)
      const before = this.route.getPointAtLength(Math.max(0, distance - 2))
      const after = this.route.getPointAtLength(Math.min(this.length, distance + 2))
      const angle = Math.atan2(after.y - before.y, after.x - before.x) * 180 / Math.PI + 90
      this.boat.style.transform = `translate(${point.x}px, ${point.y}px) translate(-50%, -50%) rotate(${angle}deg)`
      this.disperseTrail(this.motion?.matches ? 0 : distance)
      const map = this.querySelector<HTMLElement>('map-closing')!
      const mapProgress = this.motion?.matches ? 1 : Math.min(1, Math.max(0,
        (scrollY + innerHeight - this.mapTop) / this.mapRevealDistance,
      ))
      map.style.setProperty('--map-reveal', String(mapProgress))
      map.style.setProperty('--map-unrevealed', `${(1 - mapProgress) * 100}%`)
      map.toggleAttribute('data-voyage-arrived', scrollProgress === 1)
      this.dataset['progress'] = progress.toFixed(3)
    }
  }

  customElements.define('story-voyage', StoryVoyage)
</script>

<style>
  story-voyage {
    position: relative;
    display: block;
    isolation: isolate;
  }

  .voyage {
    position: absolute;
    z-index: 1;
    inset: 0;
    overflow: clip;
    pointer-events: none;
  }

  .voyage__chart {
    display: none;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .voyage--ready .voyage__chart {
    display: block;
  }

  .voyage__route {
    stroke: none;
  }

  .voyage__trail {
    stroke: var(--polo-color-text-secondary);
    stroke-linecap: round;
  }

  .voyage__boat {
    position: absolute;
    top: 440px;
    left: 18%;
    width: 36px;
    transform-origin: center;
    color: var(--polo-color-text-secondary);
  }

  .voyage--ready .voyage__boat {
    top: 0;
    left: 0;
  }

  @media (max-width: 1040px) {
    .voyage__boat {
      width: 32px;
      top: calc(100% - 820px);
    }
  }

  @media (max-width: 600px) {
    .voyage__boat {
      width: 26px;
      top: calc(100% - 980px);
    }
  }
</style>
