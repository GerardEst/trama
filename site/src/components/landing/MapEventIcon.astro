---
import { Image } from 'astro:assets'
import type { MapEventKind } from './map-events'
import discovery from '../../assets/landing/map-illustrations/discovery.webp'
import treasure from '../../assets/landing/map-illustrations/treasure.webp'
import potion from '../../assets/landing/map-illustrations/potion.webp'
import camp from '../../assets/landing/map-illustrations/camp.webp'
import relic from '../../assets/landing/map-illustrations/relic.webp'

interface Props {
  kind: MapEventKind
}

const illustrations = { discovery, treasure, potion, camp, relic }
---

<Image class="map-event-icon" src={illustrations[Astro.props.kind]} width={384} height={384} alt="" loading="lazy" decoding="async" aria-hidden="true" />

<style>
  .map-event-icon {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: var(--map-illustration-filter, none);
  }

  :global(:root[data-polo-theme='dark']) .map-event-icon {
    --map-illustration-filter: invert(1) hue-rotate(180deg);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-polo-theme='light'])) .map-event-icon {
      --map-illustration-filter: invert(1) hue-rotate(180deg);
    }
  }

</style>
