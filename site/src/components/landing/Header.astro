---
import AuthLabel from '../ui/AuthLabel.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS } from '../../lib/links'
import { localePath } from '../../lib/locale'
import { PAGES, type PagePath } from '../../lib/pages'

interface Props {
  lang: Lang
  /** Absolute links to the current direction's sections. */
  home: string
  /** The page being read, marked in the menu. */
  page?: PagePath
  /** Uses the hero's call to action, so the page asks for one thing in one way. */
  heroCta?: boolean
}

const { lang, home, page = PAGES.home, heroCta = false } = Astro.props
const t = copyFor(lang)
const pageLink = (target: PagePath, label: string) => ({
  href: localePath(lang, target),
  label,
  current: page === target,
})
const sections = [
  { href: `${home}#features`, label: t.nav.features, current: false },
  pageLink(PAGES.useCases, t.nav.useCases),
  pageLink(PAGES.pricing, t.nav.pricing),
  { href: `${home}#engine`, label: t.nav.engine, current: false },
  pageLink(PAGES.features, t.nav.docs),
]
---

<header class="ln">
  <landing-nav>
    <nav class="ln__inner" aria-label={t.nav.label}>
      <a class="ln__mark" href={home} aria-label={t.nav.home}>Trama<span>.</span></a>
      <div class="ln__links" id="ln-links">
        {sections.map(section => (
          <a href={section.href} aria-current={section.current ? 'page' : undefined}>{section.label}</a>
        ))}
        <a class="ln__links-login" href={APP_LINKS.login} data-when="signed-out">{t.nav.login}</a>
      </div>
      <a class="ln__login" href={APP_LINKS.login} data-when="signed-out">{t.nav.login}</a>
      <a class="ln__cta" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
        <AuthLabel signedOut={heroCta ? t.hero.startStory : t.nav.start} signedIn={t.nav.dashboard} />
      </a>
      <button class="ln__toggle" type="button" aria-expanded="false" aria-controls="ln-links">
        <span data-when-menu="closed">{t.nav.menu}</span><span data-when-menu="open">{t.nav.close}</span>
      </button>
    </nav>
  </landing-nav>
</header>

<script>
  // On narrow screens the links fold under a Menu button. The document is only
  // listened to while the menu is open.
  class LandingNav extends HTMLElement {
    private get toggle() { return this.querySelector<HTMLButtonElement>('.ln__toggle')! }

    connectedCallback() {
      this.toggle.addEventListener('click', this.onToggle)
    }

    disconnectedCallback() {
      this.toggle.removeEventListener('click', this.onToggle)
      this.unlisten()
    }

    private onToggle = () => this.setOpen(!this.hasAttribute('open'))

    private setOpen(open: boolean) {
      this.toggleAttribute('open', open)
      this.toggle.setAttribute('aria-expanded', String(open))
      if (open) {
        document.addEventListener('keydown', this.onKey)
        document.addEventListener('click', this.onClick)
      } else {
        this.unlisten()
      }
    }

    private unlisten() {
      document.removeEventListener('keydown', this.onKey)
      document.removeEventListener('click', this.onClick)
    }

    private onKey = (event: KeyboardEvent) => {
      if (event.key !== 'Escape') return
      this.setOpen(false)
      this.toggle.focus()
    }

    // A click outside closes the menu, and so does following one of its links:
    // most lead to a section of the page that is already open.
    private onClick = (event: MouseEvent) => {
      const target = event.target as Element
      if (!this.contains(target) || target.closest('.ln__links a')) this.setOpen(false)
    }
  }

  customElements.define('landing-nav', LandingNav)
</script>
