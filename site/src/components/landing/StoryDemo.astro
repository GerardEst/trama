---
import { createGame } from '@trama-app/engine'
import { buildExampleStory, EXAMPLE_STORY_COPY } from '@app/app/shared/example-story/exampleStory'
import AuthLabel from '../ui/AuthLabel.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS } from '../../lib/links'
import { renderStep, type StepStrings } from '../../lib/story-step'
import { landingCopyFor } from './content'

interface Props {
  lang: Lang
  class?: string
  /** Shows the live list of what the story has remembered so far. */
  memory?: boolean
}

const { lang, class: className, memory = false } = Astro.props
const t = copyFor(lang)
const lab = landingCopyFor(lang)
const story = buildExampleStory(EXAMPLE_STORY_COPY[lang])
const strings: StepStrings = t.player
// The opening scene is in the HTML, so it shows before any script runs.
const opening = renderStep(createGame(story).start(), strings)
const storyJson = JSON.stringify(story).replace(/</g, '\\u003c')
---

<story-demo id="try-it" class={className} role="region" aria-label={t.hero.demoLabel} data-strings={JSON.stringify(strings)}>
  <slot />
  <div class="ls-game">
    <div class="story-step" data-step set:html={opening} />
  </div>
  {memory && (
    <div class="ls-memory">
      <span class="ls-memory__label">{lab.ui.memoryLabel}</span>
      <ul data-memory aria-live="polite"><li class="ls-memory__empty" data-memory-empty>{lab.ui.memoryEmpty}</li></ul>
    </div>
  )}
  <div class="ls-next" data-next hidden>
    <p>{t.demo.endingStart} {t.demo.endingEnd}</p>
    <a href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
      <AuthLabel signedOut={t.demo.createFirst} signedIn={t.demo.makeAnother} />
      <span aria-hidden="true">→</span>
    </a>
  </div>
  <div class="ls-foot">
    <span data-intro>{t.demo.intro}</span>
    <span data-ended hidden>{t.demo.ended}</span>
    <button type="button" data-restart hidden><span aria-hidden="true">↺</span> {t.demo.restart}</button>
  </div>
  <script type="application/json" data-story set:html={storyJson} />
</story-demo>

<script>
  import { createGame, type Game, type StateChange, type StoryTree } from '@trama-app/engine'
  import { renderStep, type StepStrings } from '../../lib/story-step'

  // Plays the example story with Trama's engine and, when asked to, lists what
  // the story remembers, so a reader sees the state a choice changes.
  class StoryDemo extends HTMLElement {
    private story!: StoryTree
    private strings!: StepStrings
    private game?: Game
    private unsubscribe?: () => void
    private started = false
    private ended = false

    connectedCallback() {
      this.story = JSON.parse(this.find('[data-story]').textContent ?? '{}')
      this.strings = JSON.parse(this.dataset['strings'] ?? '{}')
      this.find('[data-step]').addEventListener('click', this.choose)
      this.find('[data-step]').addEventListener('submit', this.submit)
      this.find('[data-restart]').addEventListener('click', this.restart)
      this.newGame()
    }

    disconnectedCallback() {
      this.unsubscribe?.()
    }

    private newGame() {
      this.unsubscribe?.()
      this.started = false
      this.ended = false
      const memory = this.querySelector('[data-memory]')
      memory?.querySelectorAll('li:not([data-memory-empty])').forEach(item => item.remove())
      memory?.querySelector<HTMLElement>('[data-memory-empty]')?.removeAttribute('hidden')
      const game = createGame(this.story)
      this.unsubscribe = game.subscribe(event => {
        if (event.type === 'answer') this.started = true
        else if (event.type === 'end') this.ended = true
        else if (event.type === 'change') this.remember(event.change)
        else if (event.type === 'state') this.render(renderStep(event.state, this.strings))
      })
      this.game = game
      game.start()
    }

    private remember(change: StateChange) {
      const memory = this.querySelector('[data-memory]')
      if (!memory) return
      const refs = (this.story as { refs?: Record<string, { name?: string }> }).refs ?? {}
      const name = refs[change.ref]?.name ?? refs[`property_${change.ref}`]?.name ?? change.ref
      let text = name
      if (change.type === 'stat') text = `${name} ${change.after}`
      else if (change.type === 'condition') text = `${name} ${change.after ? '✓' : '✕'}`
      // Long values are sentences written for the ending, not memory worth listing.
      else if (String(change.after).length > 28) return
      else text = `${name}: ${change.after}`
      memory.querySelector<HTMLElement>('[data-memory-empty]')?.setAttribute('hidden', '')
      const item = document.createElement('li')
      item.dataset['ref'] = change.ref
      item.textContent = text
      const previous = memory.querySelector(`li[data-ref="${CSS.escape(change.ref)}"]`)
      if (previous) previous.replaceWith(item)
      else memory.append(item)
    }

    private render(html: string) {
      const step = this.find('[data-step]')
      const hadFocus = this.contains(document.activeElement) && document.activeElement !== document.body
      step.innerHTML = html
      this.find('[data-next]').hidden = !this.ended
      this.find('[data-intro]').hidden = this.ended
      this.find('[data-ended]').hidden = !this.ended
      this.find('[data-restart]').hidden = !this.started
      this.toggleAttribute('data-ended', this.ended)
      this.toggleAttribute('data-started', this.started)
      // Keep keyboard readers on the story instead of losing focus to the page.
      if (hadFocus) {
        const next = this.ended
          ? this.find<HTMLAnchorElement>('[data-next] a')
          : step.querySelector<HTMLElement>('button:not(:disabled), input')
        next?.focus()
      }
    }

    private choose = (event: Event) => {
      const answer = (event.target as Element).closest<HTMLButtonElement>('button[data-answer]')
      if (answer && !answer.disabled) this.game?.choose(answer.dataset['answer']!)
    }

    private submit = (event: Event) => {
      event.preventDefault()
      const value = new FormData(event.target as HTMLFormElement).get('answer')
      if (typeof value === 'string' && value.trim()) this.game?.submitText(value.trim())
    }

    private restart = () => {
      this.newGame()
    }

    private find<T extends HTMLElement = HTMLElement>(selector: string): T {
      return this.querySelector<T>(selector)!
    }
  }

  customElements.define('story-demo', StoryDemo)
</script>
