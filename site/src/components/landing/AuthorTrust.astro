---
import Eyebrow from '../ui/Eyebrow.astro'
import { copyFor, type Lang } from '../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).trust
const points = [
  { mark: '✓', copy: t.saving },
  { mark: '↶', copy: t.history },
  { mark: '↓', copy: t.data },
]
---

<section id="trust" class="author-trust" aria-labelledby="trust-title">
  <div class="section-container">
    <div class="author-trust__heading">
      <Eyebrow>{t.eyebrow}</Eyebrow>
      <h2 id="trust-title">{t.title}</h2>
      <p>{t.description}</p>
    </div>
    <div class="author-trust__points">
      {points.map(({ mark, copy }) => (
        <article>
          <span class="author-trust__mark" aria-hidden="true">{mark}</span>
          <h3>{copy.title}</h3>
          <p>{copy.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .author-trust {
    padding: 64px 0 72px;
    border-top: 1px solid var(--polo-color-border);
    background: var(--polo-color-action-soft);
  }

  .author-trust__heading {
    max-width: 800px;
  }

  h2 {
    margin-top: 16px;
  }

  .author-trust__heading > p:last-child {
    max-width: 620px;
    margin-top: 20px;
    color: var(--polo-color-text-secondary);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
  }

  .author-trust__points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 36px;
    margin-top: 36px;
  }

  article {
    padding-top: 24px;
    border-top: 1px solid var(--polo-color-border-strong);
  }

  .author-trust__mark {
    color: var(--polo-color-action);
    font-size: 28px;
  }

  h3 {
    margin: 16px 0 12px;
    font-size: 19px;
    font-weight: 800;
    line-height: 1.4;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  .author-trust__points p {
    color: var(--polo-color-text-secondary);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.7;
  }

  @media (max-width: 760px) {
    .author-trust {
      padding: 48px 0;
    }
    .author-trust__points {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
      margin-top: 28px;
    }
  }
</style>
