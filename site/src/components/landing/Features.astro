---
import FeatureCard from './FeatureCard.astro'
import Eyebrow from '../ui/Eyebrow.astro'
import ButtonLink from '../ui/ButtonLink.astro'
import EventsVisual from './visuals/EventsVisual.astro'
import DistributorVisual from './visuals/DistributorVisual.astro'
import PlayerInputVisual from './visuals/PlayerInputVisual.astro'
import RequirementsVisual from './visuals/RequirementsVisual.astro'
import FocusModeVisual from './visuals/FocusModeVisual.astro'
import OrganisationVisual from './visuals/OrganisationVisual.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS } from '../../lib/links'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)

// Each card opens its chapter of the feature guide (the fragments are its ids).
const FEATURES = [
  { copy: t.features.events, chapter: 'events', Visual: EventsVisual, wide: true },
  { copy: t.features.distributors, chapter: 'distributors', Visual: DistributorVisual, wide: false },
  { copy: t.features.playerInput, chapter: 'player-input', Visual: PlayerInputVisual, wide: false },
  { copy: t.features.requirements, chapter: 'requirements', Visual: RequirementsVisual, wide: true },
  { copy: t.features.focusMode, chapter: 'focus-mode', Visual: FocusModeVisual, wide: true },
  { copy: t.features.organisation, chapter: 'organisation', Visual: OrganisationVisual, wide: false },
]
---

<section id="features" class="section-container features" aria-labelledby="features-title">
  <div class="features__heading">
    <Eyebrow>{t.features.eyebrow}</Eyebrow>
    <h2 id="features-title">{t.features.titleStart} <em>{t.features.titleEnd}</em></h2>
    <p class="features__description">{t.features.description}</p>
  </div>
  <div class="features__grid">
    {FEATURES.map(({ copy, chapter, Visual, wide }) => (
      <FeatureCard
        label={copy.label}
        title={copy.title}
        description={copy.description}
        link={{ href: `${APP_LINKS.docs}#${chapter}`, label: copy.link }}
        wide={wide}
      >
        <Visual lang={lang} />
      </FeatureCard>
    ))}
  </div>
  <div class="features__footer">
    <ButtonLink href={APP_LINKS.docs} arrow="→">{t.footer.guide}</ButtonLink>
  </div>
</section>

<style>
  .features {
    padding: 88px 0 96px;
    scroll-margin-top: var(--site-header-offset);
  }

  .features__heading {
    max-width: 720px;
    margin: 0 auto 48px;
    text-align: center;
  }

  h2 {
    margin-top: var(--polo-space-4);
  }
  h2 em {
    position: relative;
    z-index: 0;
    font-style: normal;
    white-space: nowrap;
  }
  h2 em::after {
    content: '';
    position: absolute;
    height: 0.16em;
    bottom: 0.05em;
    left: 1%;
    width: 98%;
    z-index: -1;
    border-radius: 50%;
    background: var(--polo-color-accent);
    transform: rotate(-1deg);
  }

  .features__description {
    max-width: 600px;
    margin: 18px auto 0;
    color: var(--polo-color-text-secondary);
    font-size: 16px;
    font-weight: 500;
    line-height: 1.7;
  }

  .features__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    grid-auto-rows: 352px;
    gap: var(--polo-space-4);
  }
  .features__grid > :global([data-wide]) {
    grid-column: span 2;
  }

  .features__footer {
    display: flex;
    justify-content: center;
    margin-top: 32px;
  }

  @media (max-width: 1000px) and (min-width: 761px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .features__grid > :global(:last-child:not([data-wide])) {
      grid-column: span 2;
    }
  }

  @media (max-width: 760px) {
    .features {
      padding: 64px 0 72px;
    }
    .features__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: minmax(420px, auto);
    }
    .features__grid > :global([data-wide]) {
      grid-column: auto;
    }
  }
</style>
