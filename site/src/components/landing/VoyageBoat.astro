---
import { Image } from 'astro:assets'
import boat from '../../assets/landing/map-illustrations/boat.webp'
---

<!-- The generated pencil drawing is seen from above, bow pointing up so that
     the whole boat turns naturally with the course. -->
<Image src={boat} width={192} height={320} alt="" loading="lazy" decoding="async" aria-hidden="true" />

<style>
  img {
    display: block;
    width: 100%;
    height: auto;
  }

  :global(:root[data-polo-theme='dark']) img {
    filter: invert(1);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-polo-theme='light'])) img {
      filter: invert(1);
    }
  }
</style>
