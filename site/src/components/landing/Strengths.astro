---
import { Image } from 'astro:assets'
import type { Lang } from '../../i18n'
import createPlate from '../../assets/landing/plates/create.webp'
import publishPlate from '../../assets/landing/plates/publish.webp'
import analysePlate from '../../assets/landing/plates/analyse.webp'
import { atlasFor } from './atlas'
import { interfaceCopyFor } from './copy'
import FeatureIcon from './FeatureIcon.astro'

// What an author does with Trama, told as three plates painted at night, over
// the night painting of .e-why: create, publish, analyse. The pictures are
// decoration; the titles and lines below them carry the facts. The rest follows
// in one quieter row.
interface Props {
  lang: Lang
}

const { lang } = Astro.props
const c = atlasFor(lang)
const e = interfaceCopyFor(lang)

// The atlas lists the wins in this order: create, publish, analyse; then logic,
// engine and a game made of several stories.
const [create, publish, analyse, ...more] = c.wins
const MORE_ICONS = ['distributors', 'engine', 'organisation'] as const
const PILLARS = [
  { win: create, verb: e.whyCreate, plate: createPlate, numeral: 'I', tilt: '-1.4deg' },
  { win: publish, verb: e.whyPublish, plate: publishPlate, numeral: 'II', tilt: '0.9deg' },
  { win: analyse, verb: e.whyAnalyse, plate: analysePlate, numeral: 'III', tilt: '-0.6deg' },
] as const
---

<div class="st">
  <ol class="st-pillars">
    {PILLARS.map(({ win, verb, plate, numeral, tilt }) => (
      <li class="st-pillar">
        <figure class="st-plate" style={`--tilt: ${tilt}`} aria-hidden="true">
          <Image src={plate} alt="" widths={[380, 760]} sizes="(max-width: 980px) 90vw, 380px" loading="lazy" />
          <figcaption><span>{numeral}</span>{verb}</figcaption>
        </figure>
        <h3>{win.title}</h3>
        <p>{win.body}</p>
      </li>
    ))}
  </ol>

  <ul class="st-more">
    {more.map((win, index) => (
      <li>
        <h3>
          <span class="st-more__icon"><FeatureIcon id={MORE_ICONS[index]} /></span>
          {win.title}
        </h3>
        <p>{win.body}</p>
      </li>
    ))}
  </ul>
</div>

<style>
  .st {
    display: grid;
    gap: 72px;
  }

  /* The three plates, laid by hand on the night: each slightly askew. */
  .st-pillars {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 40px;
    list-style: none;
  }
  .st-pillar {
    display: flex;
    flex-direction: column;
  }
  .st-plate {
    margin: 0;
    padding: 10px 10px 0;
    background: var(--polo-color-night-text);
    box-shadow: 0 24px 50px -18px color-mix(in srgb, black 60%, transparent);
    rotate: var(--tilt);
    transition: rotate 0.5s ease, translate 0.5s ease;
  }
  .st-plate img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }
  .st-plate figcaption {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 2px 12px;
    color: var(--polo-color-illustration-ink);
    font: 400 15px / 1 var(--e-serif);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .st-plate figcaption span {
    color: var(--e-red);
  }
  @media (hover: hover) {
    .st-pillar:hover .st-plate {
      rotate: 0deg;
      translate: 0 -6px;
    }
  }
  .st-pillar h3 {
    margin: 34px 0 10px;
    font-size: clamp(26px, 2.3vw, 32px);
    line-height: 1.12;
    letter-spacing: -0.015em;
  }
  .st-pillar > p {
    max-width: 380px;
    color: var(--polo-color-night-text-secondary);
    font-size: 17px;
    line-height: 1.55;
  }

  /* The quieter row */
  .st-more {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    padding-top: 28px;
    border-top: 1px solid var(--polo-color-night-line);
    list-style: none;
  }
  .st-more h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
    font-size: 20px;
    line-height: 1.25;
  }
  .st-more__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 32px;
    height: 32px;
    border: 1px solid var(--polo-color-night-line);
    border-radius: 50%;
    color: var(--polo-color-night-accent);
    font: 600 15px var(--e-sans);
  }
  .st-more p {
    padding-left: 42px;
    color: var(--polo-color-night-text-secondary);
    font-size: 15px;
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .st-pillars,
    .st-more {
      grid-template-columns: minmax(0, 1fr);
    }
    .st-pillars {
      gap: 56px;
    }
    .st-plate {
      max-width: 440px;
    }
    .st-pillar > p {
      max-width: 560px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-plate {
      transition: none;
    }
  }
</style>
