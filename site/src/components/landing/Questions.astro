---
import { copyFor, type Lang } from '../../i18n'

interface Props {
  lang: Lang
}

const t = copyFor(Astro.props.lang).questions
const questions = [t.code, t.readers, t.download, t.export, t.create]
---

<section id="questions" class="questions" aria-labelledby="questions-title">
  <div class="section-container questions__inner">
    <h2 id="questions-title">{t.title}</h2>
    <div class="questions__list">
      {questions.map(({ question, answer }) => (
        <details>
          <summary>{question}</summary>
          <p>{answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .questions {
    padding: 64px 0 48px;
    background: var(--polo-color-surface);
  }

  .questions__inner {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 64px;
  }

  h2 {
    font: 800 28px / 1.3 var(--polo-font-ui);
    letter-spacing: -0.045em;
  }

  details {
    padding: 16px 0;
    border-bottom: 1px solid var(--polo-color-border);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: var(--polo-space-4);
    min-height: 44px;
    align-items: center;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.6;
    cursor: pointer;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    color: var(--polo-color-action);
    font-size: 20px;
    font-weight: 400;
    line-height: 1.2;
  }
  summary:hover {
    color: var(--polo-color-action);
  }
  details[open] summary::after {
    content: '–';
  }

  details p {
    margin-top: var(--polo-space-3);
    color: var(--polo-color-text-secondary);
    font-size: 15px;
    line-height: 1.6;
  }

  @media (max-width: 760px) {
    .questions {
      padding: 48px 0 32px;
    }
    .questions__inner {
      grid-template-columns: 1fr;
      gap: var(--polo-space-3);
    }
    h2 {
      font-size: 23px;
    }
  }
</style>
