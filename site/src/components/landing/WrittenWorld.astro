---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import { buildExampleStory, EXAMPLE_STORY_COPY } from '@app/app/shared/example-story/exampleStory'
import type { Lang } from '../../i18n'

// The valley is made of words. Where the pointer passes, the drawing tears and
// shows what is underneath: the example story, set in the book's type, each
// letter in the colour of the landscape it sits under. A few seconds later the
// tears close again.
//
// Touch devices, small screens and reduced motion use only the painting below.
// Desktop readers can reveal the words by moving a mouse over the hero.
interface Props {
  image: ImageMetadata
  lang: Lang
  class?: string
  /** A selector, inside the same section, for words the drawing does not tear over. */
  quiet?: string
}

const { image, lang, class: className, quiet } = Astro.props
const copy = EXAMPLE_STORY_COPY[lang]
const story = buildExampleStory(copy)

// The variables in the story's text read as one playthrough's values would.
const values: Record<string, string> = {
  property_title: copy.titles.ember,
  property_deed: copy.skills.ember.deed,
}
const plain = (html: string) =>
  html
    .replace(/<span[^>]*data-key="([^"]+)"[^>]*>[^<]*<\/span>/g, (_, key: string) => values[key] ?? '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()

// One line per scene: its name, its text, and each answer after an arrow.
const passages = story.nodes
  .filter(node => node.text)
  .map(node => ({
    name: node.name ?? '',
    text: plain(node.text ?? ''),
    answers: (node.answers ?? []).map(answer => plain(answer.text ?? '')),
  }))
---

<written-world class:list={['ww', className]} aria-hidden="true" data-passages={JSON.stringify(passages)} data-quiet={quiet}>
  <Image class="ww-image" src={image} alt="" widths={[480, 768, 960, 1440, 1928]} sizes="100vw" loading="eager" fetchpriority="high" />
  <canvas class="ww-canvas" aria-hidden="true"></canvas>
</written-world>

<script>
  // Keep the initial page static. Neither the shaders nor Three.js are fetched
  // on touch devices, small screens, reduced motion, or before pointer use.
  class WrittenWorld extends HTMLElement {
    private eligibility?: MediaQueryList
    private surface: HTMLElement | null = null
    private effect?: { destroy(): void }
    private loading = false

    connectedCallback() {
      this.surface = this.parentElement
      this.eligibility = matchMedia('(min-width: 1041px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)')
      this.eligibility.addEventListener('change', this.sync)
      this.sync()
    }

    disconnectedCallback() {
      this.eligibility?.removeEventListener('change', this.sync)
      this.stop()
    }

    private stop() {
      this.surface?.removeEventListener('pointermove', this.activate)
      this.effect?.destroy()
      this.effect = undefined
    }

    private sync = () => {
      this.stop()
      if (this.eligibility?.matches) {
        this.surface?.addEventListener('pointermove', this.activate, { passive: true })
      }
    }

    private activate = async (event: PointerEvent) => {
      if (event.pointerType === 'touch' || this.loading || this.effect || !this.eligibility?.matches) return
      this.loading = true
      this.surface?.removeEventListener('pointermove', this.activate)
      try {
        // The HTML image stays visible while it loads and the optional effect starts.
        await this.querySelector('img')?.decode().catch(() => undefined)
        if (!this.isConnected || !this.eligibility.matches) return
        const { enhanceWrittenWorld } = await import('./written-world-effect')
        if (!this.isConnected || !this.eligibility.matches) return
        this.surface?.removeEventListener('pointermove', this.activate)
        this.effect = enhanceWrittenWorld(this)
      } catch {
        // The decorative effect is optional; the image and content remain usable.
      } finally {
        this.loading = false
      }
    }
  }

  customElements.define('written-world', WrittenWorld)
</script>
