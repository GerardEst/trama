---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { StoryTree } from '@trama-app/engine'

// The cover is made of words. Where the pointer passes, the drawing tears and
// shows what is underneath: the story the cover belongs to, set in the book's
// type, each letter in the colour of the landscape it sits under. A few seconds
// later the tears close again.
//
// Touch devices, small screens and reduced motion use only the painting below.
// Desktop readers can reveal the words by moving a mouse over the hero.
interface Props {
  image: ImageMetadata
  /** The story written under the painting. */
  story: StoryTree
  /** The scene this cover paints; it rests while the hero shows another. */
  scene: string
  /** Values for the variables in the story's text, as one playthrough would read them. */
  values?: Record<string, string>
  class?: string
  /** A selector, inside the same section, for words the drawing does not tear over. */
  quiet?: string
}

const { image, story, scene, values = {}, class: className, quiet } = Astro.props

const plain = (html: string) =>
  html
    .replace(/<span[^>]*data-key="([^"]+)"[^>]*>[^<]*<\/span>/g, (_, key: string) => values[key] ?? '')
    .replace(/<[^>]+>/g, ' ')
    .replace(/\s+/g, ' ')
    .trim()

// One line per scene: its name (if it has one), its text, and each answer after an arrow.
const passages = (story.nodes ?? [])
  .filter(node => node.text)
  .map(node => ({
    name: node.name ?? '',
    text: plain(node.text ?? ''),
    answers: (node.answers ?? []).map(answer => plain(answer.text ?? '')),
  }))
---

<written-world class:list={['ww', className]} aria-hidden="true" data-scene={scene} data-passages={JSON.stringify(passages)} data-quiet={quiet}>
  <Image class="ww-image" src={image} alt="" widths={[480, 768, 960, 1440, 1928]} sizes="100vw" loading="eager" fetchpriority="high" />
  <canvas class="ww-canvas" aria-hidden="true"></canvas>
</written-world>

<script>
  // Keep the initial page static. The WebGL effect is not fetched
  // on touch devices, small screens, reduced motion, or before pointer use.
  class WrittenWorld extends HTMLElement {
    // While another landscape covers this one (the hero's other stories), the
    // effect rests: nothing listens to the pointer and nothing is drawn.
    static observedAttributes = ['inactive']
    private eligibility?: MediaQueryList
    private surface: HTMLElement | null = null
    private effect?: { destroy(): void }
    private loading = false

    connectedCallback() {
      this.surface = this.parentElement
      this.eligibility = matchMedia('(min-width: 1041px) and (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)')
      this.eligibility.addEventListener('change', this.sync)
      this.sync()
    }

    disconnectedCallback() {
      this.eligibility?.removeEventListener('change', this.sync)
      this.stop()
    }

    attributeChangedCallback() {
      if (this.eligibility) this.sync()
    }

    private stop() {
      this.surface?.removeEventListener('pointermove', this.activate)
      this.effect?.destroy()
      this.effect = undefined
    }

    private sync = () => {
      this.stop()
      if (this.eligibility?.matches && !this.hasAttribute('inactive')) {
        this.surface?.addEventListener('pointermove', this.activate, { passive: true })
      }
    }

    private activate = async (event: PointerEvent) => {
      if (event.pointerType === 'touch' || this.loading || this.effect || !this.eligibility?.matches || this.hasAttribute('inactive')) return
      this.loading = true
      this.surface?.removeEventListener('pointermove', this.activate)
      try {
        // The HTML image stays visible while it loads and the optional effect starts.
        await this.querySelector('img')?.decode().catch(() => undefined)
        if (!this.isConnected || !this.eligibility.matches) return
        const { enhanceWrittenWorld } = await import('./written-world-effect')
        if (!this.isConnected || !this.eligibility.matches || this.hasAttribute('inactive')) return
        this.surface?.removeEventListener('pointermove', this.activate)
        this.effect = enhanceWrittenWorld(this)
      } catch {
        // The decorative effect is optional; the image and content remain usable.
      } finally {
        this.loading = false
      }
    }
  }

  customElements.define('written-world', WrittenWorld)
</script>
