---
import { getImage } from 'astro:assets'
import landscape from '../../assets/landing/story-map-ink-landscape.webp'
import portrait from '../../assets/landing/story-map-ink-portrait.webp'
import colourLandscape from '../../assets/landing/story-map-colour-landscape.webp'
import colourPortrait from '../../assets/landing/story-map-colour-portrait.webp'
import paperBoat from '../../assets/landing/map-illustrations/paper-boat.webp'
import waterLandscape from '../../assets/landing/story-map-water-landscape.png?url'
import waterPortrait from '../../assets/landing/story-map-water-portrait.png?url'
import edgeMask from '../../assets/landing/map-edge-mask.svg?url'

import { MAP_EVENTS } from './map-events'
import MapEventIcon from './MapEventIcon.astro'

const wide = await getImage({ src: landscape, width: 1984, format: 'webp' })
const tall = await getImage({ src: portrait, width: 1024, format: 'webp' })
const colourWide = await getImage({ src: colourLandscape, width: 1984, format: 'webp' })
const colourTall = await getImage({ src: colourPortrait, width: 1024, format: 'webp' })
const paperBoatImage = await getImage({ src: paperBoat, width: 192, format: 'webp' })
---

<div class="story-map" aria-hidden="true">
  <picture style={{ '--map-edge-mask': `url("${edgeMask}")` }}>
    <source media="(max-width: 600px)" srcset={tall.src} width="1024" height="1536" />
    <img class="story-map__image" src={wide.src} width="1984" height="1024" alt="" loading="lazy" decoding="async" />
    <canvas class="story-map__colour" data-colour-wide={colourWide.src} data-colour-tall={colourTall.src} data-water-wide={waterLandscape} data-water-tall={waterPortrait} data-paper-boat={paperBoatImage.src}></canvas>
  </picture>
  <canvas class="story-map__footprints"></canvas>
  <div class="story-map__events">
    {MAP_EVENTS.map(({ kind, position, mobilePosition, tabletPosition = position }) => (
      <div class="map-event" data-event={kind} style={`--event-x: ${position[0]}%; --event-y: ${position[1]}%; --event-tablet-x: ${tabletPosition[0]}%; --event-tablet-y: ${tabletPosition[1]}%; --event-mobile-x: ${mobilePosition[0]}%; --event-mobile-y: ${mobilePosition[1]}%`}>
        <div class="map-event__body">
          <span class="map-event__badge"><MapEventIcon kind={kind} /></span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .story-map {
    --map-image-filter: grayscale(1) contrast(1.12) brightness(1.1);
    --map-image-blend: multiply;
    --map-image-opacity: 0.62;
    position: relative;
    width: 100%;
    height: 100%;
    opacity: 1;
  }

  .story-map__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: var(--map-image-filter);
    mix-blend-mode: var(--map-image-blend);
    opacity: var(--map-image-opacity);
  }

  picture {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    mask-image: var(--map-edge-mask);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    opacity: var(--map-reveal, 1);
    clip-path: inset(0 0 var(--map-unrevealed, 0%) 0);
  }

  .story-map__colour,
  .story-map__footprints {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .story-map__colour {
    mix-blend-mode: var(--map-image-blend);
    filter: var(--map-colour-filter, none);
  }

  .story-map__footprints {
    color: var(--polo-color-text-strong);
  }

  .story-map__events {
    position: absolute;
    inset: 0;
  }

  .map-event {
    position: absolute;
    left: var(--event-x);
    top: var(--event-y);
    transform: translate(-50%, -50%);
  }

  .map-event__body {
    display: grid;
    justify-items: center;
    opacity: 0;
    transform: translateY(6px) scale(0.96);
    transition: opacity 0.25s ease-out, transform 0.25s ease-out;
  }

  .map-event--discovered .map-event__body {
    opacity: 1;
    transform: none;
  }

  .map-event__badge {
    display: block;
    width: clamp(128px, 12vw, 180px);
    height: clamp(128px, 12vw, 180px);
    background: radial-gradient(ellipse, var(--polo-color-canvas) 25%, color-mix(in srgb, var(--polo-color-canvas) 88%, transparent) 45%, transparent 72%);
  }

  :global(.closing--pending) .story-map {
    opacity: 0;
  }

  :global(:root[data-polo-theme='dark']) .story-map {
    --map-image-filter: grayscale(1) invert(1) contrast(1.12);
    --map-image-blend: screen;
    --map-image-opacity: 0.48;
    --map-colour-filter: invert(1) hue-rotate(180deg);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-polo-theme='light'])) .story-map {
      --map-image-filter: grayscale(1) invert(1) contrast(1.12);
      --map-image-blend: screen;
      --map-image-opacity: 0.48;
      --map-colour-filter: invert(1) hue-rotate(180deg);
    }
  }

  @media (min-width: 601px) and (max-width: 1000px) {
    .map-event__badge {
      width: clamp(104px, 14vw, 140px);
      height: clamp(104px, 14vw, 140px);
    }

    .story-map__image {
      object-position: 30% center;
    }

    .map-event {
      left: var(--event-tablet-x);
      top: var(--event-tablet-y);
    }
  }

  @media (max-width: 600px) {
    .story-map__image {
      /* Crop the portrait drawing's own paper margin at the footer. */
      height: calc(100% + 48px);
    }

    .map-event {
      left: var(--event-mobile-x);
      top: var(--event-mobile-y);
    }

    .map-event__badge {
      width: clamp(100px, 27vw, 136px);
      height: clamp(100px, 27vw, 136px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    picture {
      clip-path: inset(0) !important;
    }

    .story-map,
    picture {
      animation: none !important;
      opacity: 1 !important;
    }

    .map-event__body {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
