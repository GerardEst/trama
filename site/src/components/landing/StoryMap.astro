---
import { getImage } from 'astro:assets'
import landscape from '../../assets/landing/story-map-ink-landscape.webp'
import portrait from '../../assets/landing/story-map-ink-portrait.webp'
import edgeMask from '../../assets/landing/map-edge-mask.svg?url'

import type { Lang } from '../../i18n'
import { interfaceCopyFor } from './copy'
import { MAP_EVENTS } from './map-events'
import MapEventIcon from './MapEventIcon.astro'

interface Props {
  lang: Lang
}

const t = interfaceCopyFor(Astro.props.lang)
const labels = {
  battle: t.mapBattle, discovery: t.mapDiscovery, treasure: t.mapTreasure,
  key: t.mapKey, potion: t.mapPotion, camp: t.mapCamp, relic: t.mapRelic,
}

const wide = await getImage({ src: landscape, width: 1984, format: 'webp' })
const tall = await getImage({ src: portrait, width: 1024, format: 'webp' })
---

<div class="story-map" aria-hidden="true">
  <picture style={{ '--map-edge-mask': `url("${edgeMask}")` }}>
    <source media="(max-width: 600px)" srcset={tall.src} width="1024" height="1536" />
    <img class="story-map__image" src={wide.src} width="1984" height="1024" alt="" loading="lazy" decoding="async" />
  </picture>
  <div class="story-map__events">
    {MAP_EVENTS.map(({ kind, position, mobilePosition, tabletPosition = position, delay }) => (
      <div class="map-event" data-event={kind} style={`--event-x: ${position[0]}%; --event-y: ${position[1]}%; --event-tablet-x: ${tabletPosition[0]}%; --event-tablet-y: ${tabletPosition[1]}%; --event-mobile-x: ${mobilePosition[0]}%; --event-mobile-y: ${mobilePosition[1]}%; --event-delay: ${delay}s`}>
        <div class="map-event__body">
          <span class="map-event__badge"><MapEventIcon kind={kind} /></span>
          <span class="map-event__label">{labels[kind]}</span>
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  .story-map {
    --map-image-filter: grayscale(1) contrast(1.12) brightness(1.1);
    --map-image-blend: multiply;
    --map-image-opacity: 0.62;
    position: relative;
    width: 100%;
    height: 100%;
    opacity: 1;
  }

  .story-map__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: var(--map-image-filter);
    mix-blend-mode: var(--map-image-blend);
    opacity: var(--map-image-opacity);
  }

  picture {
    display: block;
    width: 100%;
    height: 100%;
    mask-image: var(--map-edge-mask);
    mask-size: 100% 100%;
    mask-repeat: no-repeat;
    opacity: var(--map-reveal, 1);
    clip-path: inset(0 0 var(--map-unrevealed, 0%) 0);
  }

  .story-map__events {
    position: absolute;
    inset: 0;
  }

  .map-event {
    position: absolute;
    left: var(--event-x);
    top: var(--event-y);
    transform: translate(-50%, -50%);
    color: var(--polo-color-action);
  }

  .map-event__body {
    display: grid;
    justify-items: center;
    gap: 1px;
    opacity: 1;
    transform: translateY(0) scale(1);
    transition: opacity 0.7s ease-out, transform 0.7s ease-out;
  }

  .map-event__badge {
    display: block;
    width: 64px;
    height: 64px;
    border-radius: 48% 52% 56% 44% / 54% 46% 54% 46%;
    background: color-mix(in srgb, var(--polo-color-canvas) 94%, transparent);
    box-shadow: 0 0 18px 8px color-mix(in srgb, var(--polo-color-canvas) 70%, transparent);
  }

  .map-event__label {
    padding: 2px 7px;
    border-radius: 4px;
    background: color-mix(in srgb, var(--polo-color-canvas) 94%, transparent);
    color: var(--polo-color-text-secondary);
    font: italic 15px / 1.3 var(--e-serif);
    white-space: nowrap;
  }

  :global(.closing--pending) .story-map {
    opacity: 0;
  }

  :global(.closing--events-pending) .map-event__body {
    opacity: 0;
    transform: translateY(6px) scale(0.94);
    transition-duration: 0.4s;
    transition-delay: 0s;
  }

  :global(.closing--arrived) .map-event__body {
    transition-delay: var(--event-delay);
  }

  :global(:root[data-polo-theme='dark']) .story-map {
    --map-image-filter: grayscale(1) invert(1) contrast(1.12);
    --map-image-blend: screen;
    --map-image-opacity: 0.48;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-polo-theme='light'])) .story-map {
      --map-image-filter: grayscale(1) invert(1) contrast(1.12);
      --map-image-blend: screen;
      --map-image-opacity: 0.48;
    }
  }

  @media (min-width: 601px) and (max-width: 1000px) {
    .story-map__image {
      object-position: 30% center;
    }

    .map-event {
      left: var(--event-tablet-x);
      top: var(--event-tablet-y);
    }
  }

  @media (max-width: 600px) {
    .story-map__image {
      /* Crop the portrait drawing's own paper margin at the footer. */
      height: calc(100% + 48px);
    }

    .map-event {
      left: var(--event-mobile-x);
      top: var(--event-mobile-y);
    }

    .map-event__badge {
      width: 46px;
      height: 46px;
    }

    .map-event__label {
      padding: 2px 4px;
      font-size: 12px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    picture {
      clip-path: inset(0) !important;
    }

    .story-map,
    picture,
    .map-event__body {
      animation: none !important;
      opacity: 1 !important;
    }

    .map-event__body {
      transform: none !important;
      transition: none !important;
    }
  }
</style>
