---
import AuthLabel from '../ui/AuthLabel.astro'
import { copyFor, format, pricingCopyFor, type Lang } from '../../i18n'
import { APP_LINKS, ENGINE_LINKS } from '../../lib/links'
import { localePath } from '../../lib/locale'
import { PAGES } from '../../lib/pages'
import {
  BILLING_PERIODS,
  PLANS,
  formatPrice,
  checkoutLink,
  planOffers,
  twelveMonths,
  type PlanId,
} from '../../lib/plans'
import LandingLayout from '../../layouts/LandingLayout.astro'
import Header from '../landing/Header.astro'
import Footer from '../landing/Footer.astro'
import FeatureIcon from '../landing/FeatureIcon.astro'
import Mark from '../ui/Mark.astro'
import { ATLAS, ATLAS_CHAPTERS, atlasFor, type AtlasId } from '../landing/atlas'
import AnalyticsSample from './AnalyticsSample.astro'
import '../../styles/landing.css'
import '../../styles/pages.css'

// The pricing page: two plans laid on the landing's squared paper, like pages of
// the same book. Both billing periods are in the HTML; the choice only hides one.
interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)
const p = pricingCopyFor(lang)
const c = atlasFor(lang)
const home = localePath(lang, PAGES.home)
const price = (amount: number) => formatPrice(lang, amount)

// Monthly shows the price alone. Yearly shows, struck through beside it, what
// the same year costs month by month, so the discount reads at a glance.
const offers = (id: PlanId) => ({
  monthly: { amount: price(PLANS[id].monthly), unit: p.perMonth, was: undefined },
  yearly: { amount: price(PLANS[id].yearly), unit: p.perYear, was: price(twelveMonths(id)) },
})
const creative = offers('creative')
const pro = offers('pro')

// Creative is the whole editor: every capability of the landing, by chapter,
// except the one Pro adds.
const PRO_ONLY: AtlasId = 'analytics'
const chapters = ATLAS_CHAPTERS.map(chapter => ({
  name: c.chapters[chapter].name,
  features: ATLAS.filter(info => info.chapter === chapter && info.id !== PRO_ONLY),
}))

const prices = {
  creativeMonthly: price(PLANS.creative.monthly),
  creativeYearly: price(PLANS.creative.yearly),
  proYearly: price(PLANS.pro.yearly),
}
const faq = p.faq.map(item => ({ question: item.question, answer: format(item.answer, prices) }))
const description = format(p.meta.description, { monthly: prices.creativeMonthly, yearly: prices.creativeYearly })

const structuredData = {
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://trama.app/#app',
      name: 'Trama',
      url: 'https://trama.app',
      applicationCategory: 'Interactive fiction editor',
      operatingSystem: 'Web browser',
      offers: planOffers(),
    },
    {
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: faq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
}
---

<LandingLayout lang={lang} page={PAGES.pricing} title={p.meta.title} description={description} structuredData={structuredData}>
  <Header lang={lang} home={home} page={PAGES.pricing} />

  <main id="main-content">
    <section class="pg-hero pr-top" aria-labelledby="pr-title">
      <div class="pg-hero__paper" aria-hidden="true"></div>
      <div class="pg-hero__copy">
        <p class="e-eyebrow">{p.eyebrow}</p>
        <h1 id="pr-title">{p.titleStart}<br />{format(p.titleEnd, { price: prices.creativeMonthly })}</h1>
        <p class="pg-hero__lead">{p.lead}</p>
      </div>

      <div class="pp">
        <fieldset class="pp-billing">
          <legend class="e-visually-hidden">{p.billing.label}</legend>
          {BILLING_PERIODS.map(period => (
            <label>
              <input type="radio" name="billing" value={period} checked={period === 'monthly'} />
              <span>{p.billing[period]}</span>
            </label>
          ))}
        </fieldset>

        <div class="pp-plans">
          <article class="pp-plan" aria-labelledby="plan-creative">
            <header class="pp-plan__head">
              <Mark kind="creative" class="pp-plan__mark" />
              <p class="pp-plan__for">{p.plans.creative.audience}</p>
              <h2 id="plan-creative">{PLANS.creative.name}</h2>
              <p class="pp-plan__lead">{p.plans.creative.lead}</p>
            </header>
            <div class="pp-plan__price">
              {BILLING_PERIODS.map(period => (
                <p class="pp-price" data-period={period}>
                  {creative[period].was && (
                    <s class="pp-price__was"><span class="e-visually-hidden">{p.wasLabel} </span>{creative[period].was}</s>
                  )}
                  {creative[period].was && <span class="e-visually-hidden">{p.nowLabel} </span>}
                  <span class="pp-price__amount">{creative[period].amount}</span>
                  <span class="pp-price__unit">{creative[period].unit}</span>
                </p>
              ))}
            </div>
            <div class="pp-plan__action">
              {BILLING_PERIODS.map(period => (
                <a
                  class="e-btn e-btn--solid"
                  href={checkoutLink(period)}
                  data-signed-in-href={APP_LINKS.dashboard}
                  data-period={period}
                >
                  <AuthLabel signedOut={p.plans.creative.cta} signedIn={t.hero.openDashboard} />
                  <span aria-hidden="true">→</span>
                </a>
              ))}
              <p class="pp-plan__action-note">{p.plans.creative.ctaNote}</p>
            </div>
            <div class="pp-plan__includes">
              <p class="pp-plan__includes-title">{p.plans.creative.includes}</p>
              <dl class="pp-chapters">
                {chapters.map(chapter => (
                  <div>
                    <dt>{chapter.name}</dt>
                    <dd>
                      {chapter.features.map((info, index) => (
                        <Fragment>{index > 0 && ', '}<a href={`${home}#f-${info.id}`}>{c.features[info.id].name}</a></Fragment>
                      ))}
                    </dd>
                  </div>
                ))}
              </dl>
            </div>
          </article>

          <article class="pp-plan" aria-labelledby="plan-pro">
            <header class="pp-plan__head">
              <Mark kind="pro" class="pp-plan__mark" />
              <p class="pp-plan__for">{p.plans.pro.audience}</p>
              <h2 id="plan-pro">{PLANS.pro.name}</h2>
              <p class="pp-plan__lead">{p.plans.pro.lead}</p>
            </header>
            <div class="pp-plan__price">
              {BILLING_PERIODS.map(period => (
                <p class="pp-price" data-period={period}>
                  {pro[period].was && (
                    <s class="pp-price__was"><span class="e-visually-hidden">{p.wasLabel} </span>{pro[period].was}</s>
                  )}
                  {pro[period].was && <span class="e-visually-hidden">{p.nowLabel} </span>}
                  <span class="pp-price__amount">{pro[period].amount}</span>
                  <span class="pp-price__unit">{pro[period].unit}</span>
                </p>
              ))}
            </div>
            <div class="pp-plan__action">
              <p class="pp-soon">{p.plans.pro.soon}</p>
              <p class="pp-plan__action-note">{p.plans.pro.ctaNote}</p>
            </div>
            <div class="pp-plan__includes">
              <p class="pp-plan__includes-title">{p.plans.pro.includes}</p>
              <dl class="pp-extra">
                {p.plans.pro.analytics.map(item => (
                  <div>
                    <dt><FeatureIcon id={PRO_ONLY} />{item.title}</dt>
                    <dd>{item.body}</dd>
                  </div>
                ))}
              </dl>
              <AnalyticsSample lang={lang} />
            </div>
          </article>
        </div>
      </div>
    </section>

    <!-- The one thing that costs nothing on either plan. -->
    <section class="e-wrap pe" aria-labelledby="pe-title">
      <span class="pe__icon"><FeatureIcon id="engine" /></span>
      <div class="pe__text">
        <p class="pe__eyebrow">{p.engine.eyebrow}</p>
        <h2 id="pe-title">{p.engine.title}</h2>
        <p>{p.engine.body}</p>
      </div>
      <p class="pe__links">
        <a class="e-link" href={`${home}#engine`}>{p.engine.more} →</a>
        <a class="e-link" href={ENGINE_LINKS.npm} rel="noopener">{t.engine.links.npm} ↗</a>
        <a class="e-link" href={ENGINE_LINKS.source} rel="noopener">{t.engine.links.source} ↗</a>
      </p>
    </section>

    <section id="faq" class="e-wrap e-faq pr-faq" aria-labelledby="e-faq-title">
      <h2 id="e-faq-title">{p.faqTitle}</h2>
      <div class="lq">
        {faq.map((item, index) => (
          <details open={index === 0}>
            <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>
  <Footer lang={lang} page={PAGES.pricing} />
</LandingLayout>

<style>
  .pp {
    width: min(100% - var(--e-gutter) * 2, 1080px);
    margin-inline: auto;
    padding-top: 40px;
  }

  /* Monthly or yearly: two radios drawn as one pill. */
  .pp-billing {
    display: flex;
    width: fit-content;
    margin: 0 auto 40px;
    padding: 4px;
    border: 1px solid var(--polo-color-border-strong);
    border-radius: 999px;
    background: var(--polo-color-canvas);
  }
  .pp-billing label {
    position: relative;
    cursor: pointer;
  }
  .pp-billing input {
    position: absolute;
    inset: 0;
    margin: 0;
    opacity: 0;
    cursor: pointer;
  }
  .pp-billing span {
    display: block;
    min-width: 112px;
    padding: 9px 22px;
    border-radius: 999px;
    color: var(--polo-color-text-secondary);
    font-size: 17px;
    line-height: 1.4;
    text-align: center;
    transition: background 0.2s, color 0.2s;
  }
  .pp-billing label:hover span {
    color: var(--polo-color-text-strong);
  }
  .pp-billing input:checked + span {
    background: var(--e-red);
    color: var(--polo-color-text-on-action);
  }
  .pp-billing input:focus-visible + span {
    outline: 2px solid var(--polo-color-action);
    outline-offset: 3px;
  }

  /* Only the chosen period shows. Where :has() is missing, both do. */
  .pp:has(input[value='monthly']:checked) [data-period='yearly'],
  .pp:has(input[value='yearly']:checked) [data-period='monthly'] {
    display: none;
  }

  /* Two pages side by side; their parts share rows, so prices and buttons line up. */
  .pp-plans {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-template-rows: repeat(3, auto) 1fr;
    gap: 0 24px;
  }
  .pp-plan {
    display: grid;
    grid-row: span 4;
    grid-template-rows: subgrid;
    padding: clamp(22px, 3.4vw, 44px);
    background: var(--polo-color-surface);
    box-shadow: 0 0 0 1px color-mix(in srgb, black 7%, transparent), 0 30px 60px -30px color-mix(in srgb, black 45%, transparent);
  }
  .pp-plan :global(.pp-plan__mark) {
    margin-bottom: 20px;
    font-size: clamp(60px, 5.6vw, 80px);
  }
  .pp-plan__for {
    color: var(--e-red);
    font-size: 17px;
  }
  .pp-plan h2 {
    margin: 4px 0 12px;
    font-size: clamp(38px, 3.8vw, 50px);
    line-height: 1.05;
  }
  .pp-plan__lead {
    max-width: 420px;
    padding-bottom: 28px;
    color: var(--polo-color-text-secondary);
  }
  .pp-plan__price {
    padding-top: 28px;
    border-top: 1px solid var(--polo-color-border);
  }
  /* The amount and its unit share a baseline; the struck price takes the line
     above them. */
  .pp-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 8px;
  }
  .pp-price__was {
    flex-basis: 100%;
    margin-bottom: 8px;
    color: var(--polo-color-text-muted);
    font-size: clamp(20px, 1.9vw, 26px);
    line-height: 1;
    white-space: nowrap;
    text-decoration-line: line-through;
    text-decoration-color: var(--e-red);
    text-decoration-thickness: 2px;
  }
  .pp-price__amount {
    font-size: clamp(52px, 5.6vw, 76px);
    line-height: 1;
    letter-spacing: -0.03em;
    word-spacing: -0.12em;
    white-space: nowrap;
  }
  .pp-price__unit {
    color: var(--polo-color-text-secondary);
    font-size: 19px;
  }
  .pp-plan__action {
    padding-block: 28px 32px;
  }
  .pp-plan__action .e-btn {
    justify-content: center;
    width: 100%;
  }
  /* Not for sale yet: the button's place, without being one. */
  .pp-soon {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    border: 1px dashed var(--polo-color-border-strong);
    border-radius: 999px;
    color: var(--polo-color-text-secondary);
    font-size: 17px;
    line-height: 1;
  }
  .pp-plan__action-note {
    margin-top: 12px;
    color: var(--polo-color-text-muted);
    font-size: 15px;
    line-height: 1.45;
    text-align: center;
  }

  .pp-plan__includes-title {
    margin-bottom: 14px;
    font-size: 19px;
  }
  .pp-chapters > div {
    display: grid;
    grid-template-columns: 112px minmax(0, 1fr);
    gap: 16px;
    padding-block: 12px;
    border-top: 1px solid var(--polo-color-border);
  }
  .pp-chapters dt {
    color: var(--e-red);
    font-size: 17px;
  }
  .pp-chapters dd,
  .pp-extra dd {
    margin: 0;
    color: var(--polo-color-text-secondary);
    font-size: 16px;
    line-height: 1.5;
  }
  .pp-chapters a {
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 4px;
    transition: color 0.2s, text-decoration-color 0.2s;
  }
  .pp-chapters a:hover {
    color: var(--polo-color-text-strong);
    text-decoration-color: var(--e-red);
  }
  .pp-extra > div {
    padding-block: 12px 16px;
    border-top: 1px solid var(--polo-color-border);
  }
  .pp-extra dt {
    display: flex;
    align-items: baseline;
    gap: 0.45em;
    margin-bottom: 4px;
    font-size: 19px;
  }
  .pp-extra dt :global(.feature-icon) {
    align-self: center;
    width: 0.9em;
    height: 0.9em;
    color: var(--e-red);
  }
  .pp-extra {
    margin-bottom: 8px;
  }

  /* The free engine: one quiet line between the plans and the questions,
     closed below by the questions' own rule. */
  .pe {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 20px 28px;
    align-items: start;
    margin-top: clamp(80px, 10vw, 128px);
    padding-block: 28px 36px;
    border-top: 1px solid var(--polo-color-border);
  }
  .pe__icon {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--polo-color-border-strong);
    border-radius: 50%;
    color: var(--e-red);
    font-size: 22px;
  }
  .pe__text {
    max-width: 640px;
  }
  .pe__eyebrow {
    color: var(--e-red);
    font-size: 15px;
  }
  .pe h2 {
    margin: 2px 0 8px;
    font-size: clamp(24px, 2.2vw, 30px);
    line-height: 1.15;
    letter-spacing: -0.015em;
  }
  .pe__text > p:last-child {
    color: var(--polo-color-text-secondary);
    font-size: 17px;
    line-height: 1.55;
  }
  .pe__links {
    display: grid;
    justify-items: start;
    gap: 6px;
    padding-top: 22px;
  }

  /* No boat sails under these questions, so they need no room for it. */
  @media (max-width: 1040px) {
    .pr-faq {
      padding-bottom: var(--e-section);
    }
  }

  @media (max-width: 860px) {
    .pp-plans {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      gap: 24px;
      max-width: 560px;
      margin-inline: auto;
    }
    .pp-plan {
      grid-row: auto;
      grid-template-rows: none;
    }
    .pe {
      grid-template-columns: auto minmax(0, 1fr);
    }
    .pe__links {
      grid-column: 2;
      padding-top: 0;
    }
  }

  @media (max-width: 480px) {
    .pe {
      grid-template-columns: minmax(0, 1fr);
    }
    .pe__links {
      grid-column: 1;
    }
  }

  @media (max-width: 480px) {
    .pp-billing span {
      min-width: 0;
    }
    .pp-chapters > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 2px;
    }
  }
</style>
