---
import BaseLayout from '../../layouts/BaseLayout.astro'
import { format, legalCopyFor, type Lang } from '../../i18n'
import { LEGAL_UPDATED, OWNER, legalHtml } from '../../lib/legal'
import { localePath } from '../../lib/locale'
import { PAGES } from '../../lib/pages'

// The privacy policy or the terms of service: a numbered list of sections,
// all in the HTML, with an index to jump to each one, and the owner's details
// at the end.
interface Props {
  lang: Lang
  doc: 'privacy' | 'terms'
}

const { lang, doc } = Astro.props
const t = legalCopyFor(lang)
const copy = t[doc]
const page = PAGES[doc]
const home = localePath(lang)
const privacy = localePath(lang, PAGES.privacy)
const links = {
  privacy,
  terms: localePath(lang, PAGES.terms),
  players: `${privacy}#players`,
  owner: '#owner',
  pricing: localePath(lang, PAGES.pricing),
  aepd: 'https://www.aepd.es',
  stripe: 'https://stripe.com/privacy',
}
const html = (text: string) => legalHtml(text, links)
const updated = new Intl.DateTimeFormat(lang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(LEGAL_UPDATED))
const owner = [
  { label: t.owner.name, value: OWNER.name },
  { label: t.owner.nif, value: OWNER.nif },
  { label: t.owner.email, value: OWNER.email, href: `mailto:${OWNER.email}` },
  ...(OWNER.address ? [{ label: t.owner.address, value: OWNER.address }] : []),
]
const structuredData = {
  '@type': 'WebPage',
  name: copy.title,
  description: copy.meta.description,
  dateModified: LEGAL_UPDATED,
  isPartOf: { '@type': 'WebSite', name: 'Trama', url: new URL(home, Astro.site).href },
}
---

<BaseLayout lang={lang} page={page} title={copy.meta.title} description={copy.meta.description} structuredData={structuredData}>
  <article class="section-container legal">
    <header class="legal__intro">
      <a class="legal__back" href={home}><span aria-hidden="true">←</span> {t.back}</a>
      <h1>{copy.title}</h1>
      <p class="legal__updated"><time datetime={LEGAL_UPDATED}>{format(t.updated, { date: updated })}</time></p>
      <p class="legal__lead">{copy.intro}</p>
    </header>

    <nav class="legal__index" aria-labelledby="legal-index">
      <h2 id="legal-index">{t.contents}</h2>
      <ol>
        {copy.sections.map(section => (
          <li><a href={`#${section.id}`}>{section.title}</a></li>
        ))}
      </ol>
    </nav>

    <div class="legal__body">
      {copy.sections.map((section, index) => (
        <section id={section.id} aria-labelledby={`${section.id}-title`}>
          <h2 id={`${section.id}-title`}><span aria-hidden="true">{index + 1}.</span> {section.title}</h2>
          {section.blocks.map(block =>
            typeof block === 'string' ? (
              <p set:html={html(block)} />
            ) : (
              <ul>{block.list.map(item => <li set:html={html(item)} />)}</ul>
            ),
          )}
        </section>
      ))}
    </div>

    <section id="owner" class="legal__owner" aria-labelledby="owner-title">
      <h2 id="owner-title">{t.ownerTitle}</h2>
      <dl>
        {owner.map(row => (
          <div>
            <dt>{row.label}</dt>
            <dd>{row.href ? <a href={row.href}>{row.value}</a> : row.value}</dd>
          </div>
        ))}
      </dl>
    </section>
  </article>
</BaseLayout>

<style>
  .legal {
    display: block;
    max-width: 820px;
    padding-bottom: 64px;
    font-weight: 500;
  }

  .legal__intro {
    padding: 48px 0 32px;
  }
  .legal__intro h1 {
    margin-top: 18px;
    font: 800 clamp(36px, 4vw, 54px)/1.12 var(--polo-font-ui);
    letter-spacing: -0.055em;
  }
  .legal__updated {
    margin-top: var(--polo-space-4);
    color: var(--polo-color-text-secondary);
    font-size: 13px;
  }
  .legal__lead {
    max-width: 680px;
    margin-top: var(--polo-space-6);
    font-size: 17px;
    line-height: 1.7;
  }

  .legal__back {
    display: inline-block;
    min-height: 44px;
    padding: 8px 0;
    font-size: 13px;
    font-weight: 700;
  }
  .legal__back:hover {
    color: var(--polo-color-action);
  }

  .legal__index,
  .legal__body {
    border: 1px solid var(--polo-color-border-strong);
    border-radius: var(--polo-radius-card);
    background: var(--polo-color-surface);
    box-shadow: 0 5px 0 color-mix(in srgb, var(--polo-color-shadow) 5%, transparent);
  }

  .legal__index {
    margin-bottom: 24px;
    padding: 20px 28px;
  }
  .legal__index h2 {
    font-size: 12px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--polo-color-action);
  }
  .legal__index ol {
    columns: 2;
    column-gap: 32px;
    margin-top: 8px;
    padding-left: 20px;
  }
  .legal__index li {
    list-style: decimal;
    break-inside: avoid;
    font-size: 13px;
  }
  .legal__index a {
    display: inline-block;
    padding: 5px 0;
    font-size: 13px;
    font-weight: 700;
  }
  .legal__index a:hover {
    color: var(--polo-color-action);
  }

  .legal__body {
    padding: 8px 40px 16px;
  }
  .legal__body section {
    padding: 28px 0;
    scroll-margin-top: 96px;
  }
  .legal__body section + section {
    border-top: 1px solid var(--polo-color-border);
  }
  .legal__body h2 {
    margin-bottom: 14px;
    font: 800 22px/1.3 var(--polo-font-ui);
    letter-spacing: -0.03em;
  }
  .legal__body h2 span {
    color: var(--polo-color-action);
  }
  .legal__body :is(p, li) {
    font-size: 15px;
    line-height: 1.7;
  }
  .legal__body p + :is(p, ul, dl),
  .legal__body :is(ul, dl) + p {
    margin-top: 14px;
  }
  .legal__body ul {
    padding-left: 22px;
  }
  .legal__body ul li {
    list-style: disc;
  }
  .legal__body li + li {
    margin-top: 8px;
  }
  /* Links in the copy come through set:html, outside the scoped styles. */
  .legal__body :is(p, li) :global(a) {
    color: var(--polo-color-action);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .legal__owner {
    margin-top: 24px;
    padding: 20px 28px;
    border: 1px solid var(--polo-color-border-strong);
    border-radius: var(--polo-radius-card);
    background: var(--polo-color-surface);
    scroll-margin-top: 96px;
  }
  .legal__owner h2 {
    margin-bottom: 12px;
    color: var(--polo-color-action);
    font-size: 12px;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }
  .legal__owner dl {
    display: grid;
    gap: 6px;
    margin: 0;
  }
  .legal__owner :is(dt, dd) {
    font-size: 15px;
    line-height: 1.7;
  }
  .legal__owner a {
    color: var(--polo-color-action);
    font-size: inherit;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .legal__owner div {
    display: grid;
    grid-template-columns: 140px minmax(0, 1fr);
    gap: 12px;
  }
  .legal__owner dt {
    color: var(--polo-color-text-secondary);
    font-weight: 700;
  }
  .legal__owner dd {
    margin: 0;
  }

  @media (max-width: 760px) {
    .legal {
      padding-bottom: 40px;
    }
    .legal__intro {
      padding: 28px 0 24px;
    }
    .legal__intro h1 {
      font-size: clamp(32px, 8vw, 46px);
    }
    .legal__index {
      padding: 16px 20px;
    }
    .legal__index ol {
      columns: 1;
    }
    .legal__body {
      padding: 0 20px 8px;
    }
    .legal__owner {
      padding: 16px 20px;
    }
    .legal__owner div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
