---
// The marks of the use cases and the plans: one object each, drawn in ink, with
// the one thing it is for in the landing's red. Drawn on a 64px grid, so they
// hold up large and small.
export type MarkKind = 'writers' | 'games' | 'brands' | 'creative' | 'pro'

interface Props {
  kind: MarkKind
  class?: string
}

const { kind, class: className } = Astro.props
---

<svg class:list={['mark', `mark--${kind}`, className]} viewBox="0 0 64 64" fill="none" aria-hidden="true" focusable="false">
  {kind === 'writers' && (
    <>
      {/* A pen nib, and the line it writes parting into two paths. */}
      <path d="M25 13V7.5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2V13" />
      <path d="M25 13h14l5 7a5 5 0 0 1 .3 5.4L32 41 19.7 25.4a5 5 0 0 1 .3-5.4z" />
      <path d="M32 41V27" />
      <circle cx="32" cy="24" r="3" />
      <g class="mark__accent">
        <path d="M32 45.5v2M32 47.5q-6 2-9 8.5M32 47.5q6 2 9 8.5" />
        <circle class="mark__dot" cx="22.5" cy="58" r="2.4" />
        <circle class="mark__dot" cx="41.5" cy="58" r="2.4" />
      </g>
    </>
  )}
  {kind === 'games' && (
    <>
      {/* A twenty-sided die, its upper face turned to the player. */}
      <path d="M32 6 54.5 19v26L32 58 9.5 45V19z" />
      <path d="M32 6v13.5M54.5 19 32 19.5 9.5 19M54.5 45 45 41.5M9.5 45l9.5-3.5M32 58 45 41.5M32 58 19 41.5M54.5 19 45 41.5M9.5 19 19 41.5" />
      <path class="mark__accent" d="M32 19.5 45 41.5H19z" />
    </>
  )}
  {kind === 'brands' && (
    <>
      {/* A megaphone, and the voice that carries. */}
      <g transform="rotate(-10 32 32)">
        <path d="M22 25.5h-7.5A4.5 4.5 0 0 0 10 30v4a4.5 4.5 0 0 0 4.5 4.5H22" />
        <path d="M22 25.5 43 14.5v35L22 38.5z" />
        <path d="M43 11v42" />
        <path d="m13.5 38.5 2.6 10.6a2.5 2.5 0 0 0 2.4 1.9h1.7a2 2 0 0 0 1.9-2.5l-2.6-10" />
        <g class="mark__accent">
          <path d="M49.5 26c2.3 3.6 2.3 8.4 0 12M54.5 20.5c5 6.8 5 16.2 0 23" />
        </g>
      </g>
    </>
  )}
  {kind === 'creative' && (
    <>
      {/* An open book, its pages written, with a ribbon marking the place. */}
      <path d="M32 17.5C26.5 13 18.5 11.5 9 12.500V47c9.5-1 17.5.5 23 5 5.5-4.5 13.5-6 23-5V12.500c-9.5-1-17.5.5-23 5z" />
      <path d="M32 17.5V52" />
      <path d="M9 51.500c9.5-1 17.5.5 23 5 5.5-4.5 13.5-6 23-5" />
      <path d="M15 20.500c4.2-.2 8 .6 11.5 2.300M15 27.500c4.2-.2 8 .6 11.5 2.300M15 34.500c4.2-.2 8 .6 11.5 2.3" />
      <path class="mark__accent" d="M40.5 13.200V31l4.2-4 4.3 4V12.3" />
    </>
  )}
  {kind === 'pro' && (
    <>
      {/* The playthroughs counted, and the line they draw upwards. */}
      <path d="M9 55h46" />
      <path d="M15 55V43.500a1.5 1.5 0 0 1 1.5-1.500h4a1.5 1.5 0 0 1 1.5 1.500V55M28.5 55V35.500a1.5 1.5 0 0 1 1.5-1.500h4a1.5 1.5 0 0 1 1.5 1.500V55M42 55V27.500a1.5 1.5 0 0 1 1.5-1.500h4a1.5 1.5 0 0 1 1.5 1.500V55" />
      <g class="mark__accent">
        <path d="M12 31.5 23.5 22l8.5 4.5 15.5-14" />
        <circle class="mark__dot" cx="49.5" cy="10.5" r="2.8" />
      </g>
    </>
  )}
</svg>

<style>
  .mark {
    display: block;
    width: 1em;
    height: 1em;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Each drawing is centred on its grid: the margins trim the box to the ink,
     so the mark lines up with the text under it. */
  .mark--writers {
    margin-inline: -0.28em;
  }
  .mark--games,
  .mark--brands,
  .mark--creative,
  .mark--pro {
    margin-inline: -0.12em;
  }
  .mark__accent {
    stroke: var(--e-red);
  }
  .mark__dot {
    fill: var(--e-red);
    stroke: none;
  }
</style>
