---
import type { GuideFeature } from '../../docs/features'

interface Props {
  feature: GuideFeature
  labels: { howTo: string; goodToKnow: string }
}

const { feature, labels } = Astro.props
---

<section class="chapter" id={feature.id} aria-labelledby={`${feature.id}-title`} tabindex="-1">
  <h2 id={`${feature.id}-title`}>{feature.title}</h2>
  <p class="chapter__summary">{feature.summary}</p>
  <h3>{labels.howTo}</h3>
  <ol>
    {feature.steps.map(step => <li>{step}</li>)}
  </ol>
  <figure class="chapter__example">
    <figcaption>{feature.example.label}</figcaption>
    {feature.example.lines.map(line => <p>{line}</p>)}
  </figure>
  <div class="chapter__note">
    <span>{labels.goodToKnow}</span>
    <p>{feature.note}</p>
  </div>
</section>

<style>
  .chapter {
    padding: 32px 0 44px;
    border-top: 1px solid var(--polo-color-border);
    scroll-margin-top: 108px;
  }
  .chapter:focus {
    outline: none;
  }

  .chapter :is(p, li) {
    font-size: 16px;
    line-height: 1.7;
  }

  .chapter h2 {
    font: 800 30px/1.3 var(--polo-font-ui);
    letter-spacing: -0.045em;
    text-wrap: balance;
  }
  .chapter h3 {
    margin: 24px 0 12px;
    font-size: 14px;
    font-weight: 800;
  }
  .chapter .chapter__summary {
    margin-top: var(--polo-space-4);
  }

  .chapter ol {
    padding-left: 24px;
  }
  .chapter li {
    list-style-type: decimal;
    margin-top: 10px;
    padding-left: 6px;
  }
  .chapter li::marker {
    color: var(--polo-color-action);
    font-size: 13px;
    font-weight: 800;
  }

  .chapter__example {
    margin: 24px 0;
    padding: 20px 24px;
    border: 1px solid var(--polo-color-border-strong);
    border-left: 3px solid var(--polo-color-action);
    border-radius: 0 10px 10px 0;
    background: var(--polo-color-action-soft);
  }
  .chapter__example figcaption {
    margin-bottom: 12px;
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 0.04em;
  }
  .chapter .chapter__example p {
    margin-top: var(--polo-space-2);
    font: 400 13px/1.8 monospace;
    overflow-wrap: anywhere;
  }

  .chapter__note > span {
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.1em;
  }
  .chapter .chapter__note p {
    margin-top: 6px;
    font-size: 13px;
  }

  @media (max-width: 760px) {
    .chapter {
      padding: 28px 0 36px;
      scroll-margin-top: 92px;
    }
    .chapter h2 {
      font-size: 27px;
    }
    .chapter ol {
      padding-left: 20px;
    }
    .chapter__example {
      padding: var(--polo-space-4);
    }
  }
</style>
