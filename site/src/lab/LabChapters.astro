---
import type { ImageMetadata } from 'astro'
import { Image } from 'astro:assets'
import type { Lang } from '../i18n'
import plateConnect from '../assets/landing/lab/plate-connect.webp'
import plateRemember from '../assets/landing/lab/plate-remember.webp'
import { localePath } from '../lib/locale'
import { PAGES } from '../lib/pages'
import Art from './Art.astro'
import LabLive from './atlas/LabLive.astro'
import { CHAPTERS, chapterParts, labCopyFor, type ChapterId, type FeatureInfo } from './content'

// The catalogue as four spreads, each composed for what its chapter is about,
// followed by one compact index of every other feature. Directions only style it:
// write pairs the node with a scene you can play, connect lays the board across
// the page, remember plays a story that keeps score, publish shows a phone.
interface Props {
  lang: Lang
  /** How each direction numbers its chapters, in order. */
  numerals: readonly [string, string, string, string]
  /** Drops the closing full stop from headings. */
  bare?: boolean
  /** Adds each chapter's scene from the example story's world, as its own plate. */
  plates?: boolean
}

const { lang, numerals, bare = false, plates = false } = Astro.props
const heading = (text: string) => (bare ? text.replace(/\.$/, '') : text)
// Only the chapters whose idea a picture tells: the fork in the road, the key.
const PLATES: Partial<Record<ChapterId, ImageMetadata>> = {
  connect: plateConnect,
  remember: plateRemember,
}
const lab = labCopyFor(lang)
const docs = localePath(lang, PAGES.features)
const link = (feature: FeatureInfo) => (feature.docs ? `${docs}#${feature.docs}` : undefined)
const parts = CHAPTERS.map(chapter => ({ chapter, ...chapterParts(chapter) }))
const rest = parts.flatMap(part => part.rest)
---

<div class="lc">
  {parts.map(({ chapter, lead }, index) => {
    const copy = lab.features[lead.id]
    const href = link(lead)
    return (
      <section id={`ch-${chapter}`} class:list={['lc-spread', `lc-spread--${chapter}`]} aria-labelledby={`lc-${chapter}`}>
        <header class="lc-head">
          <span class="lc-n" aria-hidden="true">{numerals[index]}</span>
          <h3 id={`lc-${chapter}`}>{lab.chapters[chapter].name}</h3>
          <p>{lab.chapters[chapter].description}</p>
        </header>
        {plates && PLATES[chapter] && <Image class="lc-plate" src={PLATES[chapter]!} alt="" widths={[800, 1560]} sizes="(max-width: 1040px) 100vw, 1280px" loading="lazy" />}
        <div id={`f-${lead.id}`} class="lc-copy">
          <h4>{href ? <a href={href}>{heading(copy.title)}</a> : heading(copy.title)}</h4>
          <p>{copy.body}</p>
        </div>
        {chapter === 'write' && (
          <div class="lc-demo">
            <figure class="lc-author"><Art feature="scene" view="author" lang={lang} /><figcaption>{copy.author}</figcaption></figure>
            <figure class="lc-play"><figcaption>{lab.ui.playable}</figcaption><LabLive id="scene" lang={lang} /></figure>
          </div>
        )}
        {chapter === 'connect' && (
          <div class="lc-demo lc-board">
            <figure class="lc-author"><Art feature="connections" view="author" lang={lang} /><figcaption>{copy.author}</figcaption></figure>
            <figure class="lc-reader"><Art feature="connections" view="reader" lang={lang} /><figcaption>{copy.reader}</figcaption></figure>
          </div>
        )}
        {chapter === 'remember' && (
          <div class="lc-demo">
            <figure class="lc-play"><figcaption>{lab.ui.playable}</figcaption><LabLive id="events" lang={lang} /></figure>
            <figure class="lc-author"><Art feature="events" view="author" lang={lang} /><figcaption>{copy.author}</figcaption></figure>
          </div>
        )}
        {chapter === 'publish' && (
          <div class="lc-demo">
            <figure class="lc-author"><Art feature="share" view="author" lang={lang} /><figcaption>{copy.author}</figcaption></figure>
            <figure class="lc-phone"><div class="lc-phone__screen"><Art feature="share" view="reader" lang={lang} /></div><figcaption>{copy.reader}</figcaption></figure>
          </div>
        )}
      </section>
    )
  })}
  <section class="lc-index" aria-labelledby="lc-index">
    <h3 id="lc-index">{lab.ui.indexTitle}</h3>
    <dl>
      {rest.map(feature => {
        const copy = lab.features[feature.id]
        const href = link(feature)
        return (
          <div id={`f-${feature.id}`}>
            <dt>{href ? <a href={href}>{copy.name}</a> : copy.name}</dt>
            <dd>{copy.body}</dd>
          </div>
        )
      })}
    </dl>
  </section>
</div>
