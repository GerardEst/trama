---
import type { ImageMetadata } from 'astro'
import { getImage } from 'astro:assets'

// The last page is first a pencil drawing on the notebook's paper, then painted
// in brush stroke by brush stroke as the reader scrolls to it. The painting moves
// a little slower than the page, and the words change from ink to cream as the
// sky behind them is painted. Without WebGL, or with reduced motion, it is simply
// the finished painting: the <img> below.
//
// The drawing is a real pencil drawing of the painting, made in ComfyUI from the
// painting itself (img2img, so every shape stays where the paint will land), in
// greys with the paper levelled to white. The shader only tints it with the page's
// paper and graphite.
interface Props {
  image: ImageMetadata
  drawing: ImageMetadata
}

const { image, drawing } = Astro.props
const plate = await getImage({ src: image, width: 1976, format: 'webp' })
const sketch = await getImage({ src: drawing, width: 1976, format: 'webp' })
---

<painted-closing class="pc" data-src={plate.src} data-drawing={sketch.src}>
  <img class="pc-image" src={plate.src} width={plate.attributes.width} height={plate.attributes.height} alt="" loading="lazy" decoding="async" />
  <canvas class="pc-canvas" aria-hidden="true"></canvas>
  <div class="pc-copy">
    <slot />
  </div>
</painted-closing>

<script>
  import type { WebGLRenderer, ShaderMaterial } from 'three'

  const VERTEX = /* glsl */ `
    varying vec2 vUv;
    void main() {
      vUv = uv;
      gl_Position = vec4(position.xy, 0.0, 1.0);
    }
  `

  // cover() fits the painting like object-fit: cover, shifted by the parallax.
  // The drawing has the painting's size, so the same fit lays it under the paint.
  // The paint arrives in long horizontal strokes, from the sky down, with a darker
  // wet rim on each stroke.
  const FRAGMENT = /* glsl */ `
    precision highp float;
    varying vec2 vUv;
    uniform sampler2D uImage;
    uniform sampler2D uDrawing;
    uniform vec2 uResolution;
    uniform vec2 uImageSize;
    uniform float uProgress;
    uniform float uShift;
    uniform vec3 uPaper;
    uniform vec3 uGraphite;

    float hash(vec2 p) { return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
    float noise(vec2 p) {
      vec2 i = floor(p), f = fract(p);
      vec2 u = f * f * (3.0 - 2.0 * f);
      return mix(mix(hash(i), hash(i + vec2(1, 0)), u.x), mix(hash(i + vec2(0, 1)), hash(i + vec2(1, 1)), u.x), u.y);
    }
    float fbm(vec2 p) {
      float v = 0.0, a = 0.5;
      for (int i = 0; i < 5; i++) { v += a * noise(p); p *= 2.03; a *= 0.5; }
      return v;
    }

    vec2 cover(vec2 uv) {
      float screen = uResolution.x / uResolution.y;
      float picture = uImageSize.x / uImageSize.y;
      vec2 scale = screen > picture ? vec2(1.0, picture / screen) : vec2(screen / picture, 1.0);
      vec2 fitted = (uv - 0.5) * scale + 0.5;
      fitted.y += uShift * (1.0 - scale.y);
      return clamp(fitted, 0.001, 0.999);
    }

    void main() {
      vec2 uv = cover(vUv);
      vec3 paint = texture2D(uImage, uv).rgb;

      // White in the drawing is bare paper, black is the darkest graphite.
      float graphite = 1.0 - texture2D(uDrawing, uv).r;
      vec3 sketch = mix(uPaper, uGraphite, graphite);

      // Brush strokes: long and horizontal, painted from the top of the sky down.
      float strokes = fbm(vec2(vUv.x * 2.2, vUv.y * 16.0)) * 0.55 + fbm(vUv * 5.0) * 0.2;
      float order = (1.0 - vUv.y) * 0.55 + strokes;
      float front = uProgress * 1.35 - 0.05;
      float painted = smoothstep(front, front - 0.06, order);
      float rim = smoothstep(front - 0.015, front - 0.05, order) - painted;
      vec3 wet = paint * (1.0 - rim * 0.25);

      gl_FragColor = vec4(mix(sketch, wet, painted), 1.0);
    }
  `

  class PaintedClosing extends HTMLElement {
    private renderer?: WebGLRenderer
    private material?: ShaderMaterial
    private frame = 0
    private visible = false
    private observer?: IntersectionObserver
    private resizer?: ResizeObserver

    connectedCallback() {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return
      this.observer = new IntersectionObserver(
        entries => {
          this.visible = entries.some(entry => entry.isIntersecting)
          if (this.visible && !this.renderer) void this.start()
          if (this.visible) this.listen()
          else this.unlisten()
        },
        { rootMargin: '400px 0px' },
      )
      this.observer.observe(this)
    }

    disconnectedCallback() {
      this.observer?.disconnect()
      this.resizer?.disconnect()
      this.unlisten()
      this.renderer?.dispose()
    }

    private async start() {
      const canvas = this.querySelector('canvas')!
      const image = this.querySelector('img')!
      const three = await import('three')
      // The painting's colours go to the screen exactly as they are in the file.
      three.ColorManagement.enabled = false
      let renderer: WebGLRenderer
      try {
        renderer = new three.WebGLRenderer({ canvas, antialias: false, alpha: false })
      } catch {
        return
      }
      const loader = new three.TextureLoader()
      const [texture, drawing] = await Promise.all([
        loader.loadAsync(this.dataset['src'] ?? image.src),
        loader.loadAsync(this.dataset['drawing']!),
      ])
      const paper = new three.Color(getComputedStyle(this).getPropertyValue('--pc-paper').trim() || '#fbf9f3')
      const graphite = new three.Color(getComputedStyle(this).getPropertyValue('--pc-graphite').trim() || '#3b3f47')
      this.material = new three.ShaderMaterial({
        vertexShader: VERTEX,
        fragmentShader: FRAGMENT,
        uniforms: {
          uImage: { value: texture },
          uDrawing: { value: drawing },
          uResolution: { value: new three.Vector2(1, 1) },
          uImageSize: { value: new three.Vector2(texture.image.width, texture.image.height) },
          uProgress: { value: 0 },
          uShift: { value: 0 },
          uPaper: { value: paper },
          uGraphite: { value: graphite },
        },
      })
      const scene = new three.Scene()
      scene.add(new three.Mesh(new three.PlaneGeometry(2, 2), this.material))
      const camera = new three.Camera()
      renderer.setPixelRatio(Math.min(devicePixelRatio, 2))
      this.renderer = renderer
      this.draw = () => renderer.render(scene, camera)
      this.resizer = new ResizeObserver(() => this.resize())
      this.resizer.observe(this)
      this.resize()
      this.setAttribute('data-painting', '')
      this.update()
    }

    private draw = () => {}

    private resize() {
      if (!this.renderer || !this.material) return
      const { width, height } = this.getBoundingClientRect()
      this.renderer.setSize(width, height, false)
      this.material.uniforms['uResolution']!.value.set(width, height)
      this.update()
    }

    private onScroll = () => {
      cancelAnimationFrame(this.frame)
      this.frame = requestAnimationFrame(() => this.update())
    }

    private listen() {
      addEventListener('scroll', this.onScroll, { passive: true })
    }

    private unlisten() {
      removeEventListener('scroll', this.onScroll)
    }

    // While the section's top climbs from the lower third of the screen to its
    // top, the drawing is painted; the painting drifts a little meanwhile.
    private update() {
      const rect = this.getBoundingClientRect()
      const enter = innerHeight * 0.7
      const done = innerHeight * 0.02
      const progress = Math.min(1, Math.max(0, (enter - rect.top) / (enter - done)))
      const travel = Math.min(1, Math.max(0, (innerHeight - rect.top) / (innerHeight + rect.height)))
      this.style.setProperty('--pc-progress', progress.toFixed(3))
      // The words sit in the upper sky, which the paint reaches at about half the way.
      this.style.setProperty('--pc-ink-mix', Math.min(1, Math.max(0, (progress - 0.5) / 0.16)).toFixed(3))
      this.style.setProperty('--pc-travel', travel.toFixed(3))
      if (this.material) {
        this.material.uniforms['uProgress']!.value = progress
        this.material.uniforms['uShift']!.value = (travel - 0.5) * 0.6
        this.draw()
      }
    }
  }

  customElements.define('painted-closing', PaintedClosing)
</script>
