---
import type { Lang } from '../../i18n'
import { atlasFor } from '../atlas'

// When another tool fits better, as signs on one post at the crossroads.
interface Props {
  lang: Lang
}

const c = atlasFor(Astro.props.lang)
---

<section class="ot" aria-labelledby="ot-title">
  <h3 id="ot-title">{c.ui.othersTitle}</h3>
  <ul class="st-post">
    {c.others.map(other => (
      <li>
        <span class="st-when">{other.when}</span>
        <b class="st-sign"><span>{other.tool}</span></b>
      </li>
    ))}
  </ul>
</section>

<style>
  .ot {
    margin-bottom: 96px;
  }
  .ot h3 {
    margin-bottom: 32px;
    font-size: clamp(26px, 2.4vw, 34px);
    letter-spacing: -0.015em;
  }

  .st-post {
    position: relative;
    display: grid;
    gap: 14px;
    max-width: 980px;
  }
  .st-post::before {
    content: '';
    position: absolute;
    top: -16px;
    bottom: -40px;
    left: calc(50% + 10px);
    width: 6px;
    border-radius: 2px;
    background: var(--lab-strong);
  }
  .st-post li {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 36px;
    align-items: center;
  }
  .st-when {
    color: var(--lab-soft);
    font-size: 18px;
    text-align: right;
  }
  .st-sign {
    --point: polygon(0 0, calc(100% - 18px) 0, 100% 50%, calc(100% - 18px) 100%, 0 100%);
    justify-self: start;
    position: relative;
    padding: 1.5px;
    background: var(--lab-ink);
    clip-path: var(--point);
    font-size: 20px;
    font-weight: 400;
  }
  .st-sign span {
    display: block;
    padding: 9px 40px 9px 22px;
    background: var(--lab-surface);
    clip-path: polygon(0 0, calc(100% - 17px) 0, 100% 50%, calc(100% - 17px) 100%, 0 100%);
  }
  .st-post li:first-child .st-sign {
    background: var(--lab-cape);
  }
  .st-post li:nth-child(even) .st-sign {
    rotate: -1.5deg;
  }
  .st-post li:nth-child(odd) .st-sign {
    rotate: 1deg;
  }

  @media (max-width: 860px) {
    .st-post::before {
      left: 8px;
    }
    .st-post li {
      grid-template-columns: minmax(0, 1fr);
      gap: 8px;
      padding-left: 28px;
    }
    .st-when {
      text-align: left;
    }
  }
</style>
