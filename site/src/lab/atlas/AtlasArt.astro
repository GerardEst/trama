---
import { Image } from 'astro:assets'
import type { Lang } from '../../i18n'
import { copyFor } from '../../i18n'
import heroImage from '../../assets/landing/modest-hero.webp'
import { labCopyFor } from '../content'
import { atlasFor } from './index'

// Illustrations for the capabilities the shared Art.astro does not draw.
type Key =
  | 'random-author'
  | 'modes-author'
  | 'modes-reader'
  | 'share-reader'
  | 'endings-author'
  | 'brand-author'
  | 'brand-reader'
  | 'safety-author'
  | 'safety-reader'
  | 'api-author'
  | 'api-reader'
  | 'agents-author'
  | 'agents-reader'

interface Props {
  name: Key
  lang: Lang
}

const { name, lang } = Astro.props
const x = atlasFor(lang).art
const a = labCopyFor(lang).art
const v = copyFor(lang).visuals
---

<div class="art" aria-hidden="true">
  {name === 'random-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{a.node}</b></div>
      <div class="art-row"><span>{x.coin}</span><i class="art-port"></i></div>
      <div class="art-route"><code>{x.atRandom}</code><span>→ {x.heads}</span></div>
      <div class="art-route"><code>{x.atRandom}</code><span>→ {x.tails}</span></div>
    </div>
  )}

  {name === 'modes-author' && (
    <div class="art-node">
      <div class="art-toggle art-toggle--pad"><i></i><span>{x.cumulative}</span></div>
    </div>
  )}
  {name === 'modes-reader' && (
    <div class="art-play">
      <p class="art-passage art-faint">{x.previousStep}</p>
      <span class="art-answer is-picked">{v.openArchive}</span>
      <p class="art-passage">{v.passageEnd}</p>
    </div>
  )}

  {name === 'share-reader' && (
    <div class="art-play art-play--flush">
      <div class="art-browser"><i></i><span>{a.slug}</span></div>
      <Image class="art-cover" src={heroImage} alt="" widths={[480, 960]} sizes="360px" />
      <div class="art-play__body">
        <p class="art-passage">{a.crossroadsText}</p>
        <span class="art-answer">{a.forest}</span>
      </div>
    </div>
  )}

  {name === 'endings-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{a.scene3}</b><span>{a.shareButton.split(' ')[0]}</span></div>
      <p class="art-node__text">{a.endingText}</p>
      <div class="art-toggle art-toggle--pad"><i></i><span>{a.shareButton}</span></div>
      <div class="art-row"><span>{a.passOn}</span></div>
      <div class="art-row"><span>{a.externalLinks}: {a.moreStories}</span></div>
    </div>
  )}

  {name === 'brand-author' && (
    <div class="art-node">
      <div class="art-field art-field--stack"><small>{x.footerText}</small><span class="art-input">{x.yourBrand}</span></div>
      <div class="art-field art-field--stack"><small>{x.footerLink}</small><span class="art-input">morgan.example</span></div>
      <div class="art-toggle art-toggle--pad"><i></i><span>{x.hideLink}</span></div>
    </div>
  )}
  {name === 'brand-reader' && (
    <div class="art-play">
      <p class="art-passage">{a.endingText}</p>
      <p class="art-brand">{x.yourBrand} ↗</p>
    </div>
  )}

  {name === 'safety-author' && (
    <div class="art-node">
      <div class="art-toolbar"><span>↶ {x.undo}</span><span>↷ {x.redo}</span><span class="art-toolbar__close">{x.exportJson}</span></div>
      <p class="art-node__text"><span class="art-chip art-chip--accent">✓ {x.saved}</span></p>
      <p class="art-node__text">{x.recovered}</p>
    </div>
  )}
  {name === 'safety-reader' && (
    <pre class="art-code"><span class="art-faint">story.json</span>
{`{
  "nodes": [ … ],
  "refs": { … },
  "entryPoint": { … }
}`}</pre>
  )}

  {name === 'api-author' && (
    <pre class="art-code"><em>GET</em> …/functions/v1/story
  ?slug=<em>{a.slug.split('/').pop()}</em></pre>
  )}
  {name === 'api-reader' && (
    <pre class="art-code">{`{
  "id": "…",
  "name": "…",
  "slug": "${a.slug.split('/').pop()}",
  "settings": { … },
  "tree": { … }
}`}</pre>
  )}

  {name === 'agents-author' && (
    <pre class="art-code"><span class="art-faint">Claude Code</span>
/plugin install trama-engine
  --marketplace <em>GerardEst/trama</em></pre>
  )}
  {name === 'agents-reader' && (
    <pre class="art-code art-code--term"><span class="art-faint">{a.crossroadsText}</span>

  1. {a.forest}
  2. {a.river}

<em>&gt;</em> <span class="art-caret"></span></pre>
  )}
</div>
