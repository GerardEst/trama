---
import { Font, Image } from 'astro:assets'
import AuthLabel from '../../components/ui/AuthLabel.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS, ENGINE_LINKS } from '../../lib/links'
import heroImage from '../../assets/landing/lab/hero.webp'
import closingImage from '../../assets/landing/lab/plate-closing.webp'
import { labCopyFor } from '../content'
import LabChapters from '../LabChapters.astro'
import LabFaq from '../LabFaq.astro'
import LabFooter from '../LabFooter.astro'
import LabLayout from '../LabLayout.astro'
import LabNav from '../LabNav.astro'
import LabPrompt from '../LabPrompt.astro'
import LabStory from '../LabStory.astro'
import './a.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)
const lab = labCopyFor(lang)
const home = `${lang === 'en' ? '' : `/${lang}`}/lab/a`
---

<LabLayout lang={lang} version="a" title={`A · Clariana — ${t.meta.title}`}>
  <Fragment slot="head">
    <Font cssVariable="--font-baskerville" />
  </Fragment>
  <LabNav lang={lang} home={home} heroCta />

  <main id="main-content">
    <section class="a-hero" aria-labelledby="a-title">
      <div class="a-hero__copy">
        <h1 id="a-title">{t.hero.titleStart}<br />{t.hero.titleEnd}</h1>
        <p class="a-hero__lead">{t.hero.description}</p>
        <div class="a-actions">
          <a class="a-btn a-btn--solid" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
            <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
            <span aria-hidden="true">→</span>
          </a>
          <a class="a-btn" href="#try-it">{t.hero.tryStory}</a>
        </div>
      </div>
      <figure class="a-plate">
        <div class="a-plate__frame">
          <Image class="a-plate__img" src={heroImage} alt="" widths={[800, 1280, 1928]} sizes="(max-width: 1040px) 100vw, 800px" loading="eager" fetchpriority="high" />
          <LabStory lang={lang} class="a-story" memory>
            <p class="a-story__title">{t.demo.titleStart} {t.demo.titleEnd}</p>
          </LabStory>
        </div>
      </figure>
    </section>

    <section id="features" class="a-section a-features" aria-labelledby="a-features-title">
      <div class="a-features__head">
        <h2 id="a-features-title">{t.authoring.title}</h2>
        <p class="a-features__lead">{t.authoring.description}</p>
      </div>
      <LabChapters lang={lang} numerals={['I', 'II', 'III', 'IV']} plates />
    </section>

    <section id="engine" class="a-engine" aria-labelledby="a-engine-title">
      <div class="a-engine__inner">
        <div class="a-engine__head">
          <p class="a-eyebrow">{t.engine.eyebrow}</p>
          <h2 id="a-engine-title">{t.engine.titleStart} {t.engine.titleEnd}</h2>
          <p>{t.engine.description}</p>
          <div class="a-engine__links">
            <a class="a-link" href={ENGINE_LINKS.npm} rel="noopener">{t.engine.links.npm} <span aria-hidden="true">↗</span></a>
            <a class="a-link" href={ENGINE_LINKS.source} rel="noopener">{t.engine.links.source} <span aria-hidden="true">↗</span></a>
          </div>
          <p class="a-engine__license">{t.engine.links.license}</p>
        </div>
        <ul class="a-engine__points">
          {Object.values(t.engine.points).map(point => (
            <li><h3>{point.title}</h3><p>{point.description}</p></li>
          ))}
        </ul>
        <LabPrompt lang={lang} />
      </div>
    </section>

    <section class="a-section a-faq" aria-labelledby="a-faq-title">
      <h2 id="a-faq-title">{t.questions.title}</h2>
      <LabFaq lang={lang} withTrust />
    </section>

    <section class="a-closing" aria-labelledby="a-closing-title">
      <Image class="a-closing__plate" src={closingImage} alt="" widths={[1024, 1976]} sizes="(max-width: 1340px) 100vw, 1280px" loading="lazy" />
      <h2 id="a-closing-title">{t.closing.titleStart} {t.closing.titleEnd}</h2>
      <p>{t.closing.yours}</p>
      <a class="a-btn a-btn--solid" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
        <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
        <span aria-hidden="true">→</span>
      </a>
    </section>
  </main>
  <LabFooter lang={lang} version="a" />
</LabLayout>
