---
import { Font, Image } from 'astro:assets'
import AuthLabel from '../../components/ui/AuthLabel.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS, ENGINE_LINKS } from '../../lib/links'
import { localePath } from '../../lib/locale'
import { PAGES } from '../../lib/pages'
import heroImage from '../../assets/landing/modest-hero.webp'
import Art from '../Art.astro'
import { CHAPTERS, chapterParts, labCopyFor } from '../content'
import LabFaq from '../LabFaq.astro'
import LabLayout from '../LabLayout.astro'
import LabPrompt from '../LabPrompt.astro'
import LabStory from '../LabStory.astro'
import LabFooter from '../LabFooter.astro'
import '../parts.css'
import './c.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)
const lab = labCopyFor(lang)
const home = `${lang === 'en' ? '' : `/${lang}`}/lab/c`
const docs = localePath(lang, PAGES.features)
const two = (n: number) => String(n).padStart(2, '0')
---

<LabLayout lang={lang} version="c" title={`C · Mirall — ${t.meta.title}`}>
  <Fragment slot="head">
    <Font cssVariable="--font-bricolage" preload />
    <Font cssVariable="--font-dm-mono" />
    <Font cssVariable="--font-instrument-sans" preload />
  </Fragment>

  <header class="c-nav">
    <nav class="c-nav__inner" aria-label={t.nav.label}>
      <div class="c-nav__side c-nav__side--l">
        <a class="ln__mark" href={home} aria-label={t.nav.home}>Trama<span>.</span></a>
        <a href="#features">{t.nav.features}</a>
        <a href="#engine">{t.nav.engine}</a>
        <a href={localePath(lang, PAGES.features)}>{t.nav.docs}</a>
      </div>
      <div class="c-nav__side c-nav__side--r">
        <a class="c-nav__login" href={APP_LINKS.login} data-when="signed-out">{t.nav.login}</a>
        <a class="c-nav__cta" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
          <AuthLabel signedOut={t.nav.start} signedIn={t.nav.dashboard} />
        </a>
      </div>
    </nav>
  </header>

  <main id="main-content">
    <section class="c-split c-hero" aria-labelledby="c-title">
      <div class="c-l">
        <div class="c-cell">
          <h1 id="c-title" class="c-mega">{t.hero.titleStart}</h1>
          <p class="c-hero__lead">{t.hero.description}</p>
          <div class="c-actions">
            <a class="c-btn c-btn--thread" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
              <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
              <span aria-hidden="true">→</span>
            </a>
          </div>
          <div class="c-hero__board">
            <Art feature="scene" view="author" lang={lang} />
            <Art feature="events" view="author" lang={lang} />
          </div>
        </div>
      </div>
      <div class="c-r">
        <div class="c-cell">
          <p class="c-mega">{t.hero.titleEnd}</p>
          <LabStory lang={lang} class="c-story" memory>
            <div class="c-story__scene">
              <Image src={heroImage} alt="" widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 640px" loading="eager" fetchpriority="high" />
              <span>{t.demo.titleStart} {t.demo.titleEnd}</span>
            </div>
          </LabStory>
        </div>
      </div>
      <span class="c-knot" aria-hidden="true"></span>
    </section>

    <section id="features" aria-labelledby="c-features-title">
      <div class="c-split c-cat">
        <div class="c-l">
          <div class="c-cell">
            <h2 id="c-features-title" class="c-big">{t.authoring.title}</h2>
          </div>
        </div>
        <div class="c-r">
          <div class="c-cell c-cat__desc">
            <p>{t.authoring.description}</p>
          </div>
        </div>
      </div>

      {CHAPTERS.map((chapter, chapterIndex) => {
        const { lead } = chapterParts(chapter)
        const copy = lab.features[lead.id]
        return (
          <>
            <div id={`ch-${chapter}`} class="c-split c-act">
              <div class="c-l"><div class="c-cell"><span class="c-act__n" aria-hidden="true">{chapterIndex + 1}</span><h3 class="c-mega">{lab.chapters[chapter].name}</h3></div></div>
              <div class="c-r"><div class="c-cell"><p class="c-act__desc">{lab.chapters[chapter].description}</p></div></div>
            </div>
            <article id={`f-${lead.id}`} class="c-split c-row">
              <div class="c-l">
                <div class="c-cell">
                  <h4>{copy.name}</h4>
                  <p class="c-voice">{copy.author}</p>
                  <div class="c-art" data-reveal><Art feature={lead.id} view="author" lang={lang} /></div>
                </div>
              </div>
              <div class="c-r">
                <div class="c-cell">
                  <p class="c-title">{lead.docs ? <a href={`${docs}#${lead.docs}`}>{copy.title}</a> : copy.title}</p>
                  <p class="c-voice c-voice--reader">{copy.reader}</p>
                  <div class="c-art" data-reveal><Art feature={lead.id} view="reader" lang={lang} /></div>
                  <p class="c-row__how">{copy.body}</p>
                </div>
              </div>
              <span class="c-port" aria-hidden="true"></span>
            </article>
          </>
        )
      })}
      <div class="c-split c-index">
        {[CHAPTERS.slice(0, 2), CHAPTERS.slice(2)].map((half, side) => (
          <div class={side === 0 ? 'c-l' : 'c-r'}>
            <div class="c-cell">
              {side === 0 && <h3 class="c-index__title">{lab.ui.indexTitle}</h3>}
              {side === 1 && <p class="c-index__title" aria-hidden="true">&nbsp;</p>}
              {half.map(chapter => (
                <dl>
                  {chapterParts(chapter).rest.map(feature => {
                    const item = lab.features[feature.id]
                    return (
                      <div id={`f-${feature.id}`}>
                        <dt>{feature.docs ? <a href={`${docs}#${feature.docs}`}>{item.name}</a> : item.name}</dt>
                        <dd>{item.body}</dd>
                      </div>
                    )
                  })}
                </dl>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section id="engine" aria-labelledby="c-engine-title">
      <div class="c-split c-engine">
        <div class="c-l">
          <div class="c-cell">
            <p class="c-tag">{t.engine.eyebrow}</p>
            <h2 id="c-engine-title" class="c-big">{t.engine.titleStart} {t.engine.titleEnd}</h2>
            <p class="c-engine__lead">{t.engine.description}</p>
            <p class="c-engine__links">
              <a href={ENGINE_LINKS.npm} rel="noopener">{t.engine.links.npm} ↗</a>
              <a href={ENGINE_LINKS.source} rel="noopener">{t.engine.links.source} ↗</a>
            </p>
            <p class="c-engine__license">{t.engine.links.license}</p>
          </div>
        </div>
        <div class="c-r">
          <div class="c-cell">
            <ul class="c-points">
              {Object.values(t.engine.points).map(point => (
                <li><h3>{point.title}</h3><p>{point.description}</p></li>
              ))}
            </ul>
          </div>
        </div>
      </div>
      <div class="c-split c-ways">
        <div class="c-l"><div class="c-cell"><LabPrompt lang={lang} part="agent" /></div></div>
        <div class="c-r"><div class="c-cell"><LabPrompt lang={lang} part="code" /></div></div>
      </div>
    </section>

    <section class="c-split c-faq" aria-labelledby="c-faq-title">
      <div class="c-l"><div class="c-cell"><h2 id="c-faq-title" class="c-big">{t.questions.title}</h2></div></div>
      <div class="c-r"><div class="c-cell"><LabFaq lang={lang} withTrust /></div></div>
    </section>

    <section class="c-split c-closing" aria-labelledby="c-closing-title">
      <div class="c-l">
        <div class="c-cell">
          <h2 id="c-closing-title" class="c-giant">{t.closing.titleStart}</h2>
          <a class="c-btn c-btn--thread" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
            <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
            <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>
      <div class="c-r">
        <div class="c-cell">
          <p class="c-giant">{t.closing.titleEnd}</p>
          <p class="c-closing__yours">{t.closing.yours}</p>
        </div>
      </div>
      <span class="c-knot" aria-hidden="true"></span>
    </section>
  </main>
  <LabFooter lang={lang} version="c" />
</LabLayout>
