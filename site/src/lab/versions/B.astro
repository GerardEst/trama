---
import { Font, Image } from 'astro:assets'
import AuthLabel from '../../components/ui/AuthLabel.astro'
import { copyFor, type Lang } from '../../i18n'
import { APP_LINKS, ENGINE_LINKS } from '../../lib/links'
import { localePath } from '../../lib/locale'
import { PAGES } from '../../lib/pages'
import heroImage from '../../assets/landing/lab/hero.webp'
import valleyImage from '../../assets/landing/lab/valley.webp'
import closingImage from '../../assets/landing/lab/plate-closing.webp'
import Art from '../Art.astro'
import type { FeatureId } from '../content'
import LabFooter from '../LabFooter.astro'
import LabLayout from '../LabLayout.astro'
import LabPrompt from '../LabPrompt.astro'
import LabStory from '../LabStory.astro'
import AtlasArt from '../atlas/AtlasArt.astro'
import LabLive from '../atlas/LabLive.astro'
import { documentation } from '../atlas/summary'
import {
  ATLAS,
  ATLAS_CHAPTERS,
  COMPARISON_CHECKED,
  COMPETITORS,
  COMPETITOR_NAMES,
  COMPETITOR_SOURCES,
  ROWS,
  atlasFor,
} from '../atlas'
import '../parts.css'
import './b.css'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = copyFor(lang)
const c = atlasFor(lang)
const home = `${lang === 'en' ? '' : `/${lang}`}/lab/b`
const docsPath = localePath(lang, PAGES.features)
const summaryPath = '/lab/llms-full.txt'
const checkedLabel = new Date(COMPARISON_CHECKED).toLocaleDateString(lang, { dateStyle: 'long', timeZone: 'UTC' })

// Each chapter opens with one capability shown large; the rest are listed.
const SIGNATURE: Partial<Record<(typeof ATLAS_CHAPTERS)[number], string>> = {
  write: 'scene',
  connect: 'connections',
  remember: 'events',
  publish: 'share',
}
// The page states the answer without the question it was written for, so a
// leading "Yes." would answer nothing; the question stays in the FAQ data.
const plain = (answer: string) => answer.replace(/^(Yes|Sí)[.,]\s*/, '').replace(/^./, letter => letter.toUpperCase())

// Capabilities the shared illustrations already draw, by the same name.
const SHARED = new Set<string>(['scene', 'focus', 'images', 'connections', 'organisation', 'events', 'requirements', 'distributors', 'input', 'variables', 'preview', 'analytics', 'engine'])

// What a search engine or an AI assistant reads first: the same facts as the page.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebApplication',
      '@id': 'https://trama.app/#app',
      name: 'Trama',
      url: 'https://trama.app',
      description: c.meta.definition,
      applicationCategory: 'Interactive fiction editor',
      operatingSystem: 'Web browser',
      inLanguage: ['en', 'es', 'ca'],
      featureList: ATLAS.map(info => `${c.features[info.id].name}: ${c.features[info.id].answer}`),
      softwareHelp: `https://trama.app${docsPath}`,
      sameAs: ['https://github.com/GerardEst/trama', ENGINE_LINKS.npm],
      offers: [
        { '@type': 'Offer', name: 'Creator (monthly)', price: '5.95', priceCurrency: 'EUR' },
        { '@type': 'Offer', name: 'Creator (yearly)', price: '49.95', priceCurrency: 'EUR' },
      ],
    },
    {
      '@type': 'SoftwareSourceCode',
      name: '@trama-app/engine',
      description: c.features.engine.answer,
      codeRepository: ENGINE_LINKS.source,
      programmingLanguage: 'TypeScript',
      license: 'https://opensource.org/license/mit',
      runtimePlatform: ['Browser', 'Node.js 18+', 'Deno', 'Workers'],
    },
    {
      '@type': 'FAQPage',
      inLanguage: lang,
      mainEntity: c.faq.map(item => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
}
---

<LabLayout lang={lang} version="b" title={`B · La Vall — ${c.meta.title}`}>
  <Fragment slot="head">
    <Font cssVariable="--font-instrument-serif" preload />
    <Font cssVariable="--font-instrument-sans" preload />
    <link rel="alternate" type="text/plain" href={summaryPath} title="Trama: full product summary" />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  </Fragment>

  <header class="v-nav">
    <nav aria-label={t.nav.label}>
      <a class="ln__mark" href={home} aria-label={t.nav.home}>Trama<span>.</span></a>
      <div class="v-nav__links">
        <a href="#features">{t.nav.features}</a>
        <a href="#compare">{c.ui.compareNav}</a>
        <a href="#build">{c.ui.audiences.developers}</a>
        <a href={docsPath}>{t.nav.docs}</a>
      </div>
      <a class="v-nav__login" href={APP_LINKS.login} data-when="signed-out">{t.nav.login}</a>
      <a class="v-nav__cta" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
        <AuthLabel signedOut={t.hero.startStory} signedIn={t.nav.dashboard} />
      </a>
    </nav>
  </header>

  <main id="main-content">
    <section class="v-hero" aria-labelledby="v-title">
      <div class="v-land" aria-hidden="true">
        <Image src={valleyImage} alt="" widths={[960, 1928]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>
      <div class="v-hero__copy">
        <h1 id="v-title">{t.hero.titleStart}<br />{t.hero.titleEnd}</h1>
        <p class="v-hero__lead">{c.meta.definition}</p>
        <div class="v-actions">
          <a class="v-btn v-btn--solid" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
            <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
            <span aria-hidden="true">→</span>
          </a>
          <a class="v-btn" href="#try-it">{t.hero.tryStory}</a>
        </div>
        <p class="v-proof">{c.ui.proof.join(' · ')}</p>
      </div>
    </section>

    <section class="v-wrap v-play" aria-labelledby="v-play-title">
      <div class="v-play__copy">
        <h2 id="v-play-title">{c.ui.playTitle}</h2>
        <p class="v-lead">{c.ui.playLead}</p>
      </div>
      <LabStory lang={lang} class="v-story" memory>
        <div class="v-story__scene">
          <Image src={heroImage} alt="" widths={[800, 1280]} sizes="(max-width: 900px) 100vw, 680px" loading="lazy" />
          <span>{t.demo.titleStart} {t.demo.titleEnd}</span>
        </div>
      </LabStory>
    </section>

    <section id="features" class="v-wrap v-atlas" aria-labelledby="v-atlas-title">
      <div class="v-atlas__head">
        <h2 id="v-atlas-title">{c.ui.indexTitle}</h2>
        <p class="v-lead">{c.ui.indexLead}</p>
      </div>

      {ATLAS_CHAPTERS.filter(chapter => SIGNATURE[chapter]).map(chapter => {
        const all = ATLAS.filter(info => info.chapter === chapter)
        const sig = all.find(info => info.id === SIGNATURE[chapter])!
        const rest = all.filter(info => info !== sig)
        const feature = c.features[sig.id]
        const link = documentation(sig, docsPath)
        return (
          <section id={`ch-${chapter}`} class="v-chapter" aria-labelledby={`ch-${chapter}-title`}>
            <header class="v-chapter__head">
              <p class="v-chapter__name">{c.chapters[chapter].name}</p>
              <h3 id={`ch-${chapter}-title`}>{c.chapters[chapter].title}</h3>
            </header>
            <article id={`f-${sig.id}`} class="v-sig">
              <div class="v-sig__copy">
                <h4>{feature.name}</h4>
                <p>{plain(feature.answer)}</p>
                <p class="v-sig__example">{feature.example}</p>
                {link && (
                  <a class="v-link" href={link} rel={sig.docs ? undefined : 'noopener'}>
                    {sig.docs ? c.ui.docs : c.ui.reference} <span aria-hidden="true">{sig.docs ? '→' : '↗'}</span>
                  </a>
                )}
              </div>
              <div class="v-sig__demo">
                <figure>
                  <figcaption>{c.ui.youSet}</figcaption>
                  <Art feature={sig.id === 'share' ? 'share' : (sig.id as FeatureId)} view="author" lang={lang} />
                </figure>
                <figure>
                  <figcaption>{sig.live ? c.ui.tryIt : c.ui.result}</figcaption>
                  {sig.live ? <LabLive id={sig.live} lang={lang} /> : <AtlasArt name="share-reader" lang={lang} />}
                </figure>
              </div>
            </article>
            <dl class="v-more">
              {rest.map(info => {
                const item = c.features[info.id]
                const href = documentation(info, docsPath)
                return (
                  <div id={`f-${info.id}`}>
                    <dt>{href ? <a href={href} rel={info.docs ? undefined : 'noopener'}>{item.name}</a> : item.name}{info.live && <span class="v-more__live">{c.ui.tryIt}</span>}</dt>
                    <dd>{plain(item.answer)}</dd>
                  </div>
                )
              })}
            </dl>
          </section>
        )
      })}
    </section>

    <section id="compare" class="v-compare" aria-labelledby="v-compare-title">
      <div class="v-wrap">
        <div class="v-center">
          <h2 id="v-compare-title">{c.ui.compareTitle}</h2>
          <p class="v-lead">{c.ui.compareLead}</p>
        </div>
        <div class="v-table" role="region" aria-labelledby="v-compare-title" tabindex="0">
          <table>
            <caption>{c.ui.compareCaption}</caption>
            <thead>
              <tr>
                <th scope="col">{c.ui.compareRow}</th>
                <th scope="col" class="is-trama">Trama</th>
                {COMPETITORS.map(id => <th scope="col">{COMPETITOR_NAMES[id]}</th>)}
              </tr>
            </thead>
            <tbody>
              {ROWS.map(row => (
                <tr>
                  <th scope="row">{c.rows[row].label}</th>
                  <td class="is-trama">{c.rows[row].trama}</td>
                  {COMPETITORS.map(id => <td>{c.rows[row][id]}</td>)}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <p class="v-table__note">
          {c.ui.compareLegend} {c.ui.compareChecked} <time datetime={COMPARISON_CHECKED}>{checkedLabel}</time>.
        </p>
        <details class="v-sources">
          <summary>{c.ui.sources}</summary>
          <ul>
            {COMPETITORS.flatMap(id => COMPETITOR_SOURCES[id].map(url => (
              <li><b>{COMPETITOR_NAMES[id]}:</b> <a href={url} rel="noopener">{url.replace(/^https:\/\/(www\.)?/, '')}</a></li>
            )))}
          </ul>
        </details>
        <div class="v-verdict">
          <div>
            <h3>{c.ui.winsTitle}</h3>
            <ul class="v-wins">
              {c.wins.map(win => <li><b>{win.title}.</b> {win.body}</li>)}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="build" class="v-wrap v-build" aria-labelledby="v-build-title">
      <div class="v-center">
        <h2 id="v-build-title">{c.ui.buildTitle}</h2>
        <p class="v-lead">{c.ui.buildLead}</p>
      </div>
      <ul class="v-points">
        {Object.values(t.engine.points).map(point => (
          <li><h3>{point.title}</h3><p>{point.description}</p></li>
        ))}
      </ul>
      <LabPrompt lang={lang} />
      <p class="v-build__links">
        <a href={ENGINE_LINKS.npm} rel="noopener">{t.engine.links.npm} ↗</a>
        <a href={ENGINE_LINKS.source} rel="noopener">{t.engine.links.source} ↗</a>
        <span>{t.engine.links.license}</span>
      </p>
      <dl class="v-more v-more--build">
        {ATLAS.filter(info => info.chapter === 'build').map(info => {
          const item = c.features[info.id]
          const href = documentation(info, docsPath)
          return (
            <div id={`f-${info.id}`}>
              <dt>{href ? <a href={href} rel="noopener">{item.name}</a> : item.name}</dt>
              <dd>{plain(item.answer)}</dd>
            </div>
          )
        })}
      </dl>
      <p class="v-ai">
        <span>{c.ui.aiTitle}</span>
        <a href={summaryPath}>{c.ui.aiLinks[0]}</a>
        <a href="https://trama.app/llms.txt" rel="noopener">{c.ui.aiLinks[1]}</a>
        <a href="https://raw.githubusercontent.com/GerardEst/trama/main/skills/trama-engine/references/story-format.md" rel="noopener">{c.ui.aiLinks[2]}</a>
        <a href="https://raw.githubusercontent.com/GerardEst/trama/main/skills/trama-engine/references/engine-api.md" rel="noopener">{c.ui.aiLinks[3]}</a>
      </p>
    </section>

    <section id="faq" class="v-wrap v-faq" aria-labelledby="v-faq-title">
      <h2 id="v-faq-title">{c.ui.faqTitle}</h2>
      <div class="lq">
        {c.faq.map((item, index) => (
          <details open={index === 0}>
            <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="v-closing" aria-labelledby="v-closing-title">
      <div class="v-land v-land--end" aria-hidden="true">
        <Image src={closingImage} alt="" widths={[1024, 1976]} sizes="100vw" />
      </div>
      <div class="v-closing__copy">
        <h2 id="v-closing-title">{t.closing.titleStart} {t.closing.titleEnd}</h2>
        <p class="v-lead">{t.closing.yours}</p>
        <a class="v-btn v-btn--solid" href={APP_LINKS.register} data-signed-in-href={APP_LINKS.dashboard}>
          <AuthLabel signedOut={t.hero.startStory} signedIn={t.hero.openDashboard} />
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>
  </main>
  <LabFooter lang={lang} version="b" />
</LabLayout>
