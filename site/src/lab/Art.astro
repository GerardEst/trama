---
import { Image } from 'astro:assets'
import { copyFor, type Lang } from '../i18n'
import heroImage from '../assets/landing/modest-hero.webp'
import { labCopyFor, type ArtView, type FeatureId } from './content'

// Each feature drawn twice, in the board's real language: what the author works
// with and what the reader gets. Directions restyle it through the --art-* variables.
interface Props {
  feature: FeatureId
  view: ArtView
  lang: Lang
}

const { feature, view, lang } = Astro.props
const a = labCopyFor(lang).art
const v = copyFor(lang).visuals
const key = `${feature}-${view}`
const stats = [
  { who: a.readerName, trust: 3, key: '✓', date: '12/10' },
  { who: 'Noor', trust: 1, key: '—', date: '11/10' },
  { who: 'Ivan', trust: 2, key: '✓', date: '09/10' },
]
---

<div class:list={['art', `art--${view}`]} aria-hidden="true">
  {key === 'scene-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{a.crossroads}</b><span>{a.node}</span></div>
      <p class="art-node__text">{a.crossroadsText}</p>
      <div class="art-row"><span>{a.forest}</span><i class="art-port"></i></div>
      <div class="art-row"><span>{a.river}</span><i class="art-port"></i></div>
    </div>
  )}
  {key === 'scene-reader' && (
    <div class="art-play">
      <p class="art-passage">{a.crossroadsText}</p>
      <span class="art-answer">{a.forest}</span>
      <span class="art-answer">{a.river}</span>
    </div>
  )}

  {key === 'focus-author' && (
    <div class="art-node art-focus">
      <div class="art-toolbar"><b>B</b><em>I</em><span>H1</span><span>H2</span><span>≡</span><span class="art-chip art-chip--accent">#</span><span class="art-toolbar__close">{v.close} ✕</span></div>
      <p class="art-focus__h">{v.chapterHeading}</p>
      <p class="art-passage">{v.passageStart} <span class="art-caret"></span></p>
    </div>
  )}
  {key === 'focus-reader' && (
    <div class="art-play">
      <p class="art-focus__h">{v.chapterHeading}</p>
      <p class="art-passage">{v.passageStart} <em>{v.passageEnd.split(/[.,]/)[0]}.</em></p>
    </div>
  )}

  {key === 'images-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{a.scene3}</b><span>{a.node}</span></div>
      <Image class="art-thumb" src={heroImage} alt="" widths={[360, 720]} sizes="360px" />
      <p class="art-node__text">{a.letterText}</p>
      <div class="art-row art-row--ghost"><span>＋ {a.addImage}</span></div>
    </div>
  )}
  {key === 'images-reader' && (
    <div class="art-play art-play--flush">
      <Image class="art-cover" src={heroImage} alt="" widths={[480, 960]} sizes="480px" />
      <div class="art-play__body">
        <p class="art-passage">{a.letterText}</p>
        <span class="art-answer">{a.read}</span>
      </div>
    </div>
  )}

  {key === 'connections-author' && (
    <div class="art-cols">
      <div class="art-cols__from">
        <div class="art-pill"><span>{a.firstVisit}</span><i class="art-port"></i></div>
        <div class="art-pill"><span>{a.comingBack}</span><i class="art-port"></i></div>
      </div>
      <svg class="art-wires" viewBox="0 0 60 120" preserveAspectRatio="none">
        <path d="M0 28 C 34 28, 26 26, 60 26" />
        <path class="is-accent" d="M0 92 C 34 92, 26 86, 60 86" />
      </svg>
      <div class="art-node art-node--entries">
        <div class="art-node__head"><i class="art-port art-port--in"></i><b>{a.market}</b><small>{a.entryText}</small></div>
        <p class="art-node__text">{a.marketText}</p>
        <div class="art-entry"><i class="art-port art-port--in is-accent"></i><small>{a.entryAnswers}</small></div>
        <div class="art-row"><span>{a.buyLamp}</span></div>
        <div class="art-row"><span>{a.leave}</span></div>
      </div>
    </div>
  )}
  {key === 'connections-reader' && (
    <div class="art-stack">
      <div class="art-play">
        <small class="art-label">{a.firstVisit}</small>
        <p class="art-passage">{a.marketText}</p>
        <span class="art-answer">{a.buyLamp}</span>
      </div>
      <div class="art-play">
        <small class="art-label">{a.comingBack}</small>
        <span class="art-answer">{a.buyLamp}</span>
        <span class="art-answer">{a.leave}</span>
      </div>
    </div>
  )}

  {key === 'organisation-author' && (
    <div class="art-org">
      <div class="art-frame">
        <span class="art-frame__tag">{a.frame} · {v.chapter2}</span>
        <div class="art-mini"><b>{a.scene1}</b></div>
        <div class="art-mini"><b>{a.scene2}</b></div>
        <div class="art-mini"><b>{a.scene3}</b></div>
      </div>
      <div class="art-group">
        <span class="art-group__icon">▣</span>
        <div><b>{a.group} · {v.chapter3}</b><small>{v.scenes}</small></div>
      </div>
    </div>
  )}
  {key === 'organisation-reader' && (
    <div class="art-play">
      <p class="art-passage">{a.oneStory}</p>
    </div>
  )}

  {key === 'events-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{a.strangerNods.split(' ').slice(0, 2).join(' ')}</b><span>{a.node}</span></div>
      <div class="art-row art-row--tall"><span>{a.helpStranger}</span><span class="art-chip art-chip--accent">{a.trust} +1</span><i class="art-port"></i></div>
      <div class="art-row art-row--tall"><span>{a.takeKey}</span><span class="art-chip art-chip--accent">{a.hasKey} ✓</span><i class="art-port"></i></div>
    </div>
  )}
  {key === 'events-reader' && (
    <div class="art-play">
      <span class="art-answer is-picked">{a.helpStranger}</span>
      <p class="art-passage">{a.strangerNods}</p>
      <div class="art-memory"><small>{a.remembers}</small><span class="art-chip art-chip--accent">{a.trust} 1</span></div>
    </div>
  )}

  {key === 'requirements-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{v.chapterHeading.split('·').pop()?.trim()}</b><span>{a.node}</span></div>
      <div class="art-row art-row--tall"><span>{v.openArchive}</span><span class="art-chip">{v.requiresKey}</span><i class="art-port"></i></div>
      <div class="art-row art-row--tall"><span>{v.buyMap}</span><span class="art-chip">{v.requiresCoins}</span><i class="art-port"></i></div>
      <div class="art-row art-row--tall"><span>{v.walkAway}</span><i class="art-port"></i></div>
    </div>
  )}
  {key === 'requirements-reader' && (
    <div class="art-play">
      <div class="art-memory"><span class="art-chip art-chip--accent">{v.hasKey}</span><span class="art-chip">{v.coins}</span></div>
      <span class="art-answer">{v.openArchive}</span>
      <span class="art-answer is-locked"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><rect x="4" y="10" width="16" height="11" rx="2" /><path d="M8 10V6a4 4 0 0 1 8 0v4" /></svg>{v.buyMap}<small>{v.requiresCoins}</small></span>
      <span class="art-answer">{v.walkAway}</span>
    </div>
  )}

  {key === 'distributors-author' && (
    <div class="art-node art-routes">
      <div class="art-node__head"><i class="art-port art-port--in"></i><b>{v.distributor}</b></div>
      <div class="art-route"><code>{v.secretRule}</code><span>→ {v.secretEntrance}</span></div>
      <div class="art-route"><code>{v.frontRule}</code><span>→ {v.frontEntrance}</span></div>
      <div class="art-route art-route--else"><code>{v.otherwise}</code><span>→ {v.gatekeeper}</span></div>
    </div>
  )}
  {key === 'distributors-reader' && (
    <div class="art-play">
      <small class="art-label">{v.secretEntrance}</small>
      <p class="art-passage">{a.secretPassage}</p>
    </div>
  )}

  {key === 'input-author' && (
    <div class="art-node">
      <div class="art-node__head"><b>{a.question}</b></div>
      <div class="art-field"><small>{a.property}</small><span class="art-chip art-chip--accent">{a.name}</span></div>
      <div class="art-row"><span class="art-faint">{a.readerName}…</span><i class="art-port"></i></div>
    </div>
  )}
  {key === 'input-reader' && (
    <div class="art-play">
      <p class="art-passage">{a.question}</p>
      <div class="art-inputrow"><span class="art-input">{a.readerName}<i class="art-caret"></i></span><span class="art-go">→</span></div>
    </div>
  )}

  {key === 'variables-author' && (
    <div class="art-node art-var">
      <p class="art-passage">{a.welcome} <span class="art-chip art-chip--accent">#{a.name}</span>.</p>
      <p class="art-var__hint"><small>{a.property}</small> <code>{a.name}</code></p>
    </div>
  )}
  {key === 'variables-reader' && (
    <div class="art-play">
      <p class="art-passage art-passage--big">{a.welcome} <mark>{a.readerName}</mark>.</p>
    </div>
  )}

  {key === 'preview-author' && (
    <div class="art-split">
      <div class="art-split__board">
        <div class="art-mini"><b>{a.scene1}</b></div>
        <div class="art-mini is-current"><b>{a.scene2}</b></div>
        <div class="art-mini"><b>{a.scene3}</b></div>
      </div>
      <div class="art-split__read">
        <div class="art-tabs"><span>{a.previewTab}</span><span class="is-on">{a.editTab}</span></div>
        <p class="art-passage art-passage--small">{v.passageStart}<span class="art-caret"></span></p>
        <div class="art-tabs art-tabs--foot"><span>← {a.back}</span></div>
      </div>
    </div>
  )}
  {key === 'preview-reader' && (
    <div class="art-play">
      <p class="art-passage">{v.passageStart}</p>
      <span class="art-answer">{a.read}</span>
    </div>
  )}

  {key === 'share-author' && (
    <div class="art-node art-share">
      <div class="art-node__head"><b>{a.shareTitle}</b></div>
      <div class="art-link"><span>{a.slug}</span><button tabindex="-1" type="button">{a.copyLink}</button></div>
      <div class="art-toggle"><i></i><span>{a.shareButton}</span></div>
      <div class="art-row art-row--ghost"><span>＋ {a.externalLinks}</span></div>
    </div>
  )}
  {key === 'share-reader' && (
    <div class="art-play">
      <p class="art-passage">{a.endingText}</p>
      <span class="art-answer is-primary">{a.passOn} ↗</span>
      <span class="art-answer">{a.moreStories} ↗</span>
    </div>
  )}

  {key === 'analytics-author' && (
    <div class="art-node art-table">
      <div class="art-node__head"><b>{a.plays}</b></div>
      <table>
        <thead><tr><th>{a.name}</th><th>{a.trust}</th><th>{a.hasKey}</th><th>{a.date}</th></tr></thead>
        <tbody>{stats.map(row => <tr><td>{row.who}</td><td><b>{row.trust}</b></td><td>{row.key}</td><td>{row.date}</td></tr>)}</tbody>
      </table>
    </div>
  )}
  {key === 'analytics-reader' && (
    <div class="art-play">
      <p class="art-passage">{a.crossroadsText}</p>
      <span class="art-answer">{a.forest}</span>
    </div>
  )}

  {key === 'engine-author' && (
    <pre class="art-code"><span class="art-faint">import</span> {'{ createGame, fetchStory }'}
<span class="art-faint">from</span> <em>'@trama-app/engine'</em>

const story = await fetchStory(<em>{'{ id }'}</em>)
createGame(story.tree).start()</pre>
  )}
  {key === 'engine-reader' && (
    <pre class="art-code art-code--term"><span class="art-faint">{a.crossroadsText}</span>

  1. {a.forest}
  2. {a.river}

<em>&gt; 2</em><span class="art-caret"></span></pre>
  )}
</div>
