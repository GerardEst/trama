---
import { copyFor, format, type Lang } from '../i18n'
import { ENGINE_LINKS } from '../lib/links'
import { engineExample, referenceCode } from '../lib/story-reference'
import { labCopyFor } from './content'
import { highlightCode } from './highlight'

interface Props {
  lang: Lang
  /** Which half to render, so a direction can place them apart. */
  part?: 'both' | 'agent' | 'code'
}

const { lang, part = 'both' } = Astro.props
const t = copyFor(lang).engine
const lab = labCopyFor(lang)
const placeholder = referenceCode(null, t.agent.placeholderId)
const prompt = format(t.agent.prompt, { reference: placeholder, npm: ENGINE_LINKS.npm })
const strings = {
  prompt: t.agent.prompt,
  npm: ENGINE_LINKS.npm,
  placeholderId: t.agent.placeholderId,
  invalid: t.agent.storyInvalid,
  copied: t.agent.copied,
  copyFailed: t.agent.copyFailed,
  copy: t.agent.copy,
}
const uid = `lab-engine-${part}`
---

<lab-prompt class="lp" data-strings={JSON.stringify(strings)}>
  {part !== 'code' && (
    <div class="lp__way">
      <span class="lp__label">{t.agent.label}</span>
      <h3>{t.agent.title}</h3>
      <p>{t.agent.description}</p>
      <label for={uid}>{lab.ui.agentField}</label>
      <input id={uid} type="text" inputmode="url" autocomplete="off" spellcheck="false" placeholder="https://trama.app/private/…" aria-describedby={`${uid}-hint`} />
      <p id={`${uid}-hint`} class="lp__hint" data-hint>{t.agent.storyHint}</p>
      <pre class="lp__code lp__code--wrap" tabindex="0" aria-label={t.agent.promptLabel} data-prompt>{prompt}</pre>
      <div class="lp__actions">
        <button type="button" data-copy>{t.agent.copy}</button>
        <span class="lp__status" aria-live="polite" data-status></span>
      </div>
    </div>
  )}
  {part !== 'agent' && (
    <div class="lp__way">
      <span class="lp__label">{t.code.label}</span>
      <h3>{t.code.title}</h3>
      <p>{t.code.description}</p>
      <pre class="lp__code" tabindex="0" aria-label={t.code.codeLabel}><code data-code set:html={highlightCode(engineExample(placeholder))} /></pre>
    </div>
  )}
</lab-prompt>

<script>
  import { format } from '../lib/format'
  import { engineExample, referenceCode, storyReference } from '../lib/story-reference'
  import { highlightCode } from './highlight'

  interface Strings {
    prompt: string
    npm: string
    placeholderId: string
    invalid: string
    copied: string
    copyFailed: string
  }

  // Writes the prompt and the example code for the story the author pastes.
  class LabPrompt extends HTMLElement {
    connectedCallback() {
      const strings: Strings = JSON.parse(this.dataset['strings'] ?? '{}')
      const input = this.querySelector('input')
      const prompt = this.querySelector('[data-prompt]')
      const status = this.querySelector('[data-status]')
      const hint = this.querySelector('[data-hint]')
      const hintText = hint?.textContent ?? ''
      input?.addEventListener('input', () => {
        const value = input.value.trim()
        const reference = value ? storyReference(value) : null
        const invalid = Boolean(value) && !reference
        input.setAttribute('aria-invalid', String(invalid))
        if (hint) hint.textContent = invalid ? strings.invalid : hintText
        const code = referenceCode(reference, strings.placeholderId)
        if (prompt) prompt.textContent = format(strings.prompt, { reference: code, npm: strings.npm })
        const example = this.querySelector('[data-code]')
        if (example) example.innerHTML = highlightCode(engineExample(code))
      })
      this.querySelector('[data-copy]')?.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(prompt?.textContent ?? '')
          if (status) status.textContent = strings.copied
        } catch {
          if (status) status.textContent = strings.copyFailed
        }
      })
    }
  }

  customElements.define('lab-prompt', LabPrompt)
</script>
