---
import { copyFor, type Lang } from '../i18n'
import { labCopyFor } from './content'

interface Props {
  lang: Lang
  /** Also answers what the landing's trust section says: saving, history and data. */
  withTrust?: boolean
}

const { lang, withTrust = false } = Astro.props
const t = copyFor(lang)
const q = t.questions
const items: { question: string; answer: string }[] = [q.code, q.create, q.readers, q.export, q.download]
if (withTrust) {
  const [saving, history] = labCopyFor(lang).ui.trustQuestions
  items.push({ question: saving, answer: t.trust.saving.description }, { question: history, answer: t.trust.history.description })
}
---

<div class="lq">
  {items.map((item, index) => (
    <details open={index === 0}>
      <summary><span>{item.question}</span><i aria-hidden="true"></i></summary>
      <p>{item.answer}</p>
    </details>
  ))}
</div>
