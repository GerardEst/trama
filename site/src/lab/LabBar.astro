---
import { LANGS, LANGUAGE_NAMES, type Lang } from '../i18n'
import { DIRECTIONS, type DirectionId } from './directions'

interface Props {
  lang: Lang
  version?: DirectionId
}

const { lang, version } = Astro.props
const prefix = (language: Lang) => (language === 'en' ? '' : `/${language}`)
const pathFor = (language: Lang, target?: string) => `${prefix(language)}/lab${target ? `/${target}` : ''}`
---

<nav class="lab-bar" aria-label="Lab">
  <a href={pathFor(lang)} aria-current={version ? undefined : 'page'}>Lab</a>
  <span class="lab-bar__sep" aria-hidden="true"></span>
  {DIRECTIONS.map(direction => (
    <a href={pathFor(lang, direction.id)} aria-current={version === direction.id ? 'page' : undefined} title={direction.name}>
      {direction.id.toUpperCase()}
    </a>
  ))}
  <span class="lab-bar__sep" aria-hidden="true"></span>
  {LANGS.map(language => (
    <a href={pathFor(language, version)} hreflang={language} aria-current={language === lang ? 'page' : undefined}>
      {LANGUAGE_NAMES[language].code}
    </a>
  ))}
  <span class="lab-bar__sep" aria-hidden="true"></span>
  <button type="button" data-lab-theme aria-label="Light or dark">◐</button>
</nav>

<script>
  // Only for comparing: never stored, so the app's real theme preference is untouched.
  document.querySelector('[data-lab-theme]')?.addEventListener('click', () => {
    const root = document.documentElement
    const dark = matchMedia('(prefers-color-scheme: dark)').matches
    const current = root.dataset['poloTheme'] ?? (root.dataset['lab'] === 'd' || dark ? 'dark' : 'light')
    root.dataset['poloTheme'] = current === 'dark' ? 'light' : 'dark'
  })
</script>

<style>
  .lab-bar {
    position: fixed;
    right: 12px;
    bottom: 12px;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1px;
    padding: 4px;
    border: 1px solid color-mix(in srgb, var(--lab-ink) 18%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--lab-canvas) 88%, transparent);
    backdrop-filter: blur(10px);
    color: var(--lab-ink);
    font: 600 11px / 1 var(--font-raleway), sans-serif;
    font-feature-settings: 'lnum';
    box-shadow: 0 6px 20px color-mix(in srgb, black 14%, transparent);
  }
  .lab-bar a,
  .lab-bar button {
    display: grid;
    place-items: center;
    min-width: 26px;
    height: 26px;
    padding: 0 6px;
    border: 0;
    border-radius: 999px;
    background: none;
    cursor: pointer;
    color: inherit;
    font: inherit;
  }
  .lab-bar a:hover,
  .lab-bar button:hover {
    background: color-mix(in srgb, var(--lab-ink) 10%, transparent);
  }
  .lab-bar [aria-current='page'] {
    background: var(--lab-ink);
    color: var(--lab-canvas);
  }
  .lab-bar [aria-current='page']:hover {
    background: var(--lab-ink);
  }
  .lab-bar__sep {
    width: 1px;
    height: 14px;
    margin: 0 3px;
    background: color-mix(in srgb, var(--lab-ink) 18%, transparent);
  }
</style>
