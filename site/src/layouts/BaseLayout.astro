---
import PageHead from './PageHead.astro'
import '../styles/global.css'
import SiteHeader from '../components/SiteHeader.astro'
import SiteFooter from '../components/SiteFooter.astro'
import { copyFor, type Lang } from '../i18n'
import type { PagePath } from '../lib/pages'

interface Props {
  lang: Lang
  /** The page, without language prefix: its other languages are its alternates. */
  page: PagePath
  title: string
  description: string
  /** schema.org data for this page; url and inLanguage are filled in here. */
  structuredData: Record<string, unknown>
}

const { lang, page, title, description, structuredData } = Astro.props
const t = copyFor(lang)
---

<!doctype html>
<html lang={lang}>
  <head>
    <PageHead lang={lang} page={page} title={title} description={description} structuredData={structuredData} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.nav.skip}</a>
    <SiteHeader lang={lang} page={page} />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter lang={lang} page={page} />
  </body>
</html>

<script>
  // Signed-in readers go straight to the app instead of signing up again.
  if (document.documentElement.hasAttribute('data-signed-in')) {
    for (const link of document.querySelectorAll<HTMLAnchorElement>('a[data-signed-in-href]')) {
      link.href = link.dataset['signedInHref']!
    }
  }
</script>

<style>
  .skip-link {
    position: absolute;
    top: -80px;
    left: 20px;
    z-index: 30;
    padding: 14px 20px;
    background: var(--polo-color-canvas);
  }
  .skip-link:focus {
    top: 12px;
  }
</style>
