---
import { Font, getImage } from 'astro:assets'
import { LANGS, type Lang } from '../i18n'
import { localePath } from '../lib/locale'
import type { PagePath } from '../lib/pages'
import { LANG_STORAGE_KEY, SESSION_STORAGE_KEY, THEME_STORAGE_KEY } from '../lib/links'
import socialImage from '../assets/landing/modest-hero.webp'
import landingImage from '../assets/landing/valley.webp'

interface Props {
  lang: Lang
  /** The page, without language prefix: its other languages are its alternates. */
  page: PagePath
  title: string
  description: string
  /** schema.org data for this page; url and inLanguage are filled in here. */
  structuredData: Record<string, unknown>
  landing?: boolean
}

const { lang, page, title, description, structuredData, landing = false } = Astro.props
const site = Astro.site!
const pathFor = (language: Lang) => localePath(language, page)
const canonical = new URL(pathFor(lang), site).href
const alternates = [
  ...LANGS.map(hreflang => ({ hreflang, href: new URL(pathFor(hreflang), site).href })),
  { hreflang: 'x-default', href: new URL(pathFor('en'), site).href },
]
// Where the English page sends readers who chose or prefer another language.
const translations = Object.fromEntries(LANGS.map(language => [language, pathFor(language)]))
const ogImage = await getImage({ src: landing ? landingImage : socialImage, width: 1200, format: 'jpeg' })
const jsonLd = { '@context': 'https://schema.org', ...structuredData, url: canonical, inLanguage: lang }
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{alternates.map(link => <link rel="alternate" hreflang={link.hreflang} href={link.href} />)}
<link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48 64x64" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="96x96" href="/favicon.png" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Trama" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={new URL(ogImage.src, site).href} />
<meta property="og:locale" content={lang} />
<meta name="twitter:card" content="summary_large_image" />
<script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />

<Font cssVariable="--font-raleway" preload />
<Font cssVariable="--font-baskerville" />
{!landing && <Font cssVariable="--font-libre-baskerville" />}

<!-- Before the first paint: the app's theme choice and whether the reader is signed in. -->
<script is:inline define:vars={{ themeKey: THEME_STORAGE_KEY, sessionKey: SESSION_STORAGE_KEY }}>
  document.documentElement.classList.add('landing-js')
  try {
    const theme = localStorage.getItem(themeKey)
    if (theme === 'dark' || theme === 'light') document.documentElement.dataset.poloTheme = theme
    if (localStorage.getItem(sessionKey)) document.documentElement.dataset.signedIn = ''
  } catch {
    // Without storage the system theme and the signed-out links still work.
  }
</script>
{lang === 'en' && (
  <script is:inline define:vars={{ langKey: LANG_STORAGE_KEY, translations }}>
    // English pages are the default: readers who chose or prefer another language go to theirs.
    try {
      const langs = Object.keys(translations)
      const saved = localStorage.getItem(langKey)
      const preferred = langs.includes(saved) ? saved
        : (navigator.languages?.length ? navigator.languages : [navigator.language])
          .map(tag => tag?.toLowerCase().split('-')[0]).find(base => langs.includes(base)) ?? 'en'
      if (preferred !== 'en') location.replace(`${translations[preferred]}${location.search}${location.hash}`)
    } catch {
      // Stay on the English page.
    }
  </script>
)}
<slot />
